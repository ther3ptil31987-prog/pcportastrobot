+// A pad's GyroToggle button (View/Back by default) tilts only while it is held. As a toggle, one
+// accidental press of View left the right stick driving the tilt instead of the camera, with no sign
+// on screen: "the right stick stops working, restarting fixes it" (pcportastrobot #128).
+// ASTROHYBRID_TILT_TOGGLE=1 restores the press-to-toggle behaviour.
+bool PadTiltIsToggle() {
+	static const bool toggle = [] {
+		const auto* value = std::getenv("ASTROHYBRID_TILT_TOGGLE");
+		return value != nullptr && std::strcmp(value, "1") == 0;
+	}();
+	return toggle;
+}
