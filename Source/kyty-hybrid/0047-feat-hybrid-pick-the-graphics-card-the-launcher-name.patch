From a74829b74c598f88719d053024f7e7e756d52166 Mon Sep 17 00:00:00 2001
From: Codex <local@invalid>
Date: Thu, 19 Nov 2026 23:55:08 +0000
Subject: [PATCH 47/47] feat(hybrid): pick the graphics card the launcher names
 in ANYPS5_GPU

The AstroHybrid launcher's graphics card choice (pcportastrobot #24) sets ANYPS5_GPU to part of the
card's name, which only AnyPS5's own renderer read: Kyty always chose automatically. With no
KYTY_GPU_INDEX, the devices whose name contains it (ignoring case) are the candidates. The launcher
lists cards through Windows, whose order need not be Vulkan's, so a name is safer than an index.
No match keeps the automatic choice; one console line says what was picked.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../presentation/window/vulkanWindow.cpp      | 28 +++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/src/graphics/presentation/window/vulkanWindow.cpp b/src/graphics/presentation/window/vulkanWindow.cpp
index 21165e69..b204619f 100644
--- a/src/graphics/presentation/window/vulkanWindow.cpp
+++ b/src/graphics/presentation/window/vulkanWindow.cpp
@@ -197,6 +197,34 @@ static void VulkanFindPhysicalDevice(vk::Instance instance, vk::SurfaceKHR surfa
 			LOGF("Vulkan GPU index %d is unavailable; selecting automatically\n",
 			     Config::GetGpuIndex());
 		}
+	} else if (const char* wanted = std::getenv("ANYPS5_GPU"); wanted != nullptr && wanted[0] != '\0') {
+		// ANYPS5_GPU=<part of a name> (the AstroHybrid launcher's graphics card choice, pcportastrobot
+		// #24): the devices whose name contains it, ignoring case. The launcher lists cards through
+		// Windows, whose order need not be Vulkan's, so it names the card instead of numbering it. No
+		// match keeps the automatic choice (AnyPS5's own renderer stops instead).
+		const auto lower = [](std::string text) {
+			std::transform(text.begin(), text.end(), text.begin(),
+			               [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+			return text;
+		};
+		const std::string                needle = lower(wanted);
+		std::vector<vk::PhysicalDevice> named;
+		std::string                      names;
+		for (const auto& device: devices) {
+			vk::PhysicalDeviceProperties properties {};
+			device.getProperties(&properties);
+			const std::string name = properties.deviceName.data();
+			names += (names.empty() ? "" : ", ") + name;
+			if (lower(name).find(needle) != std::string::npos) {
+				named.push_back(device);
+			}
+		}
+		if (!named.empty()) {
+			devices = named;
+		}
+		std::printf("Kyty GPU: ANYPS5_GPU=\"%s\" %s (devices: %s)\n", wanted,
+		            named.empty() ? "matches no device, selecting automatically" : "selects the matching device",
+		            names.c_str());
 	} else if (vk::PhysicalDevice headset; Vr::OpenXrPhysicalDevice(instance, headset)) {
 		devices = {headset}; // The headset runtime renders on this GPU.
 	}
