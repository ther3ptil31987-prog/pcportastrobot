diff --git a/src/graphics/presentation/window/hostInput.cpp b/src/graphics/presentation/window/hostInput.cpp
index 10ea3afc..ba8095ad 100644
--- a/src/graphics/presentation/window/hostInput.cpp
+++ b/src/graphics/presentation/window/hostInput.cpp
@@ -1037,6 +1037,28 @@ void HostInputToggleMouseToJoystick() {
 	LOGF("Mouse to right stick: enabled (F7 to release)\n");
 }
 
+static void FinishHostEvent(SDL_Event* event, bool has_event) {
+	if (Config::HideCursorEnabled() && !TouchPadModeActive()) {
+		const auto now_ms = SDL_GetTicks();
+		if (has_event && !g_mouse.enabled && IsCursorActivity(*event) &&
+		    SDL_GetWindowFromEvent(event) == g_mouse_window) {
+			SDL_ShowCursor();
+			g_cursor_hide_at = now_ms + CURSOR_IDLE_HIDE_MS;
+		} else if (g_cursor_hide_at != 0 && now_ms >= g_cursor_hide_at) {
+			SDL_HideCursor();
+			g_cursor_hide_at = 0;
+		}
+	}
+
+	if (has_event && event->type == SDL_EVENT_WINDOW_FOCUS_LOST &&
+	    event->window.windowID == SDL_GetWindowID(g_mouse_window)) {
+		Common::HostInputTrace("focus-lost", 0, 0);
+		g_input_pulse.ReleaseAll(ApplyHostKey);
+		g_mouse.next_poll = 0;
+		CenterMouseStick();
+	}
+}
+
 bool HostInputWaitEvent(SDL_Event* event, int max_wait_ms) {
 	// -1 waits without a deadline (until max_wait_ms below).
 	int timeout = g_input_pulse.Poll(SDL_GetTicks(), ApplyHostKey);
@@ -1067,26 +1089,18 @@ bool HostInputWaitEvent(SDL_Event* event, int max_wait_ms) {
 		EXIT("%s\n", SDL_GetError());
 	}
 
-	if (Config::HideCursorEnabled() && !TouchPadModeActive()) {
-		const auto now_ms = SDL_GetTicks();
-		if (has_event && !g_mouse.enabled && IsCursorActivity(*event) &&
-		    SDL_GetWindowFromEvent(event) == g_mouse_window) {
-			SDL_ShowCursor();
-			g_cursor_hide_at = now_ms + CURSOR_IDLE_HIDE_MS;
-		} else if (g_cursor_hide_at != 0 && now_ms >= g_cursor_hide_at) {
-			SDL_HideCursor();
-			g_cursor_hide_at = 0;
-		}
-	}
+	FinishHostEvent(event, has_event);
+	return has_event;
+}
 
-	if (has_event && event->type == SDL_EVENT_WINDOW_FOCUS_LOST &&
-	    event->window.windowID == SDL_GetWindowID(g_mouse_window)) {
-		Common::HostInputTrace("focus-lost", 0, 0);
-		g_input_pulse.ReleaseAll(ApplyHostKey);
-		g_mouse.next_poll = 0;
-		CenterMouseStick();
+bool HostInputDrainEvent(SDL_Event* event) {
+	// Pop already-pumped events without invoking SDL_WaitEventTimeout(..., 0), which would re-pump
+	// Windows/HID devices for every high-rate gyro/accel sample during Switch Pro or PS5 bursts.
+	if (SDL_PeepEvents(event, 1, SDL_GETEVENT, SDL_EVENT_FIRST, SDL_EVENT_LAST) <= 0) {
+		return false;
 	}
-	return has_event;
+	FinishHostEvent(event, true);
+	return true;
 }
 
 } // namespace Libs::Graphics
