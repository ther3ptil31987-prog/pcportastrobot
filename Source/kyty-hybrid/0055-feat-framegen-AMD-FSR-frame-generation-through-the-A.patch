+// Depth and motion vectors of one rendered frame, copied at the game's upscale pass.
+struct Slot {
+	uint64_t       frame = 0;
+	bool           valid = false;
+	uint32_t       width = 0, height = 0;            // the part in use (the frame's render size)
+	uint32_t       image_width = 0, image_height = 0; // the images' size: the largest render size seen
+	VkFormat       motion_format = VK_FORMAT_UNDEFINED;
+	VkImage        depth         = VK_NULL_HANDLE; // R32_SFLOAT
+	VkDeviceMemory depth_memory  = VK_NULL_HANDLE;
+	VkImage        motion        = VK_NULL_HANDLE;
+	VkDeviceMemory motion_memory = VK_NULL_HANDLE;
+	float          jitter[2] {};
+	float          frame_ms = 16.7f;
+	float          camera_near = 0.1f, camera_far = 1000.0f, camera_fov = 1.0f;
+	float          camera_position[3] {}, camera_up[3] {0, 1, 0}, camera_right[3] {1, 0, 0},
+	    camera_forward[3] {0, 0, -1};
+};
+
+// HUD-less colour: an image of the swapchain's size and format, or the copy of a display buffer in
+// the presenter's frame format it is scaled from.
+struct HudImage {
+	VkImage        image  = VK_NULL_HANDLE;
+	VkDeviceMemory memory = VK_NULL_HANDLE;
+	uint32_t       width = 0, height = 0;
+	VkFormat       format  = VK_FORMAT_UNDEFINED;
+	uint64_t       serial  = 0; // the token of the copy it holds (0: none)
+	uint64_t       address = 0; // the display buffer it was taken from
+};
+constexpr uint32_t HUD_COUNT = 4;
+
+// A run of draws into one colour target, for the log's description of the end of a frame.
