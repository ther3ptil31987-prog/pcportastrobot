@@ -0,0 +1,111 @@
+#ifndef EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_FSR_H_
+#define EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_FSR_H_
+
+#include "graphics/host_gpu/renderer/frameGen.h"
+
+#include <cstdint>
+
+#include <vulkan/vulkan_core.h>
+
+// AMD FSR frame generation (FSR Frame Generation 3.1.6 with its frame-interpolation swapchain 3.1.7;
+// FSR 4 versions where the runtime offers them for the card) through the AMD FSR SDK 2.4 API. The
+// SDK's signed Vulkan runtime is loaded at run time from ASTROHYBRID_FSR_PATH, else from the folder of
+// this module: amd_fidelityfx_loader_vk.dll (also used by FSR upscaling, fsr.inc) and
+// amd_fidelityfx_framegeneration_vk.dll next to it. Needs a build with KYTY_FFX_SDK_DIR; works on any
+// Vulkan GPU with three spare queues in its graphics family.
+//
+// ASTROHYBRID_FSRFG=1 (default 0; off with ASTROHYBRID_DLSSG=1): FSR frame generation, one generated
+// frame per rendered frame.
+//  - Three more queues of the graphics family are created (FSR's swapchain needs its own queues for
+//    async compute, composition/present and image acquisition).
+//  - Kyty's swapchain is created through FSR's frame-interpolation swapchain: acquire and present
+//    go through its replacement functions, and the presented image is left in
+//    SHADER_READ_ONLY_OPTIMAL (what that swapchain expects) instead of PRESENT_SRC.
+//  - The frame hooks are DLSS-G's (frameGen.h forwards them here when this is requested): the
+//    camera from the game's per-view constants, and at the game's temporal upscale pass the depth
+//    and motion vectors, which are copied into a small ring of images owned by this module (the
+//    game's are valid only at that point; the depth copy is R32F, so any D32 format works). The
+//    game renders at a dynamic resolution: the copies keep the largest size seen and FSR is told
+//    the part in use.
+//  - Everything FSR does for frame generation is recorded on the present thread, in the
+//    swapchain's frame-generation callback: "prepare" with the copies of the presented frame, then
+//    the interpolation. A frame without inputs (loading screens, menus drawn without the upscale
+//    pass, a repeated present) shows the real frame twice.
+//  - VK_NV_low_latency2 and DLSS-G stay off with it (the swapchain is FSR's). The game's own
+//    upscaling, DLSS Super Resolution (ASTROHYBRID_DLSS) and FSR upscaling (ASTROHYBRID_FSR, dlss.h)
+//    all work with it.
+//  Options: ASTROHYBRID_FSRFG_ASYNC=0 runs the interpolation on the game queue instead of the
+//  async compute queue; ASTROHYBRID_FSRFG_DEBUG=1 draws FSR's debug view and tear lines;
+//  ASTROHYBRID_FSRFG_HUD=0 turns the HUD-less copy below off; ASTROHYBRID_FSR_DEPTH_INVERTED=1|0
+//  (default: ASTROHYBRID_DLSS_DEPTH_INVERTED, else 0) and ASTROHYBRID_DLSS_JITTER_SIGN as for DLSS.
+//  One "FSR FG 10s:" console line every 10 s (ending with the video memory in use).
+//
+// Fsr::Requested() (dlss.h) is FSR upscaling; the functions here are frame generation only.
+namespace Libs::Graphics::Fsr {
+
+[[nodiscard]] bool FrameGenRequested();
+
+// Device creation: how many more queues of the graphics family to create (0 or 3), given how many
+// the family has and how many are already taken.
+[[nodiscard]] uint32_t ExtraQueues(uint32_t family_queue_count, uint32_t used);
+// Locks the game queue for one submission from another thread (GraphicContext::queue_mutex).
+using QueueLock = void (*)(bool lock);
+struct DeviceInfo {
+	VkPhysicalDevice physical_device = VK_NULL_HANDLE;
+	VkDevice         device          = VK_NULL_HANDLE;
+	uint32_t         queue_family    = 0;
+	VkQueue          game_queue      = VK_NULL_HANDLE;
+	VkQueue          extra_queues[3] = {};
+	uint32_t         extra_count     = 0;
+	QueueLock        queue_lock      = nullptr;
+};
+void OnDeviceReady(const DeviceInfo& info);
+
+// Frame generation (frameGen.h forwards these when FrameGenRequested()).
+[[nodiscard]] bool FrameGenActive();
+void RenderSubmitted(uint64_t frame);
+[[nodiscard]] uint64_t CurrentFrame();
+void PresentStart(uint64_t frame);
+void PresentEnd(uint64_t frame);
+[[nodiscard]] double ShownPerGameFrame();
+[[nodiscard]] bool CameraWanted();
+void SetCamera(const float* constants);
+bool TagFrame(VkCommandBuffer cmd, const FrameGen::ImageInput& depth, const FrameGen::ImageInput& motion,
+              const float jitter_uv[2], uint32_t width, uint32_t height);
+
+// HUD-less colour for frame generation (ASTROHYBRID_FSRFG_HUD=0 turns it off). Without it the
+// game's HUD is interpolated with the picture and smears when the camera moves. The game draws the
+// HUD into the display buffer after its last full-screen pass: before the first blended draw that
+// follows an unblended one there, the display buffer is scaled into an image of the swapchain's
+// size and format exactly as the present does it later. FSR interpolates that image and takes
+// every pixel in which the presented frame differs from it (the HUD) from the real frame.
+//
+// A flip (PrepareFrame, in command order): the guest address of the display buffer, the format of
+// the presenter's frame and the buffer's size. Returns the token of the HUD-less copy taken from
+// this buffer since the previous flip (0: none), which travels with the presenter's frame.
+[[nodiscard]] uint64_t NoteDisplayFrame(uint64_t address, VkFormat frame_format, uint32_t width, uint32_t height);
+// Whether a guest address is that of a display buffer flipped lately (render thread).
+[[nodiscard]] bool DisplayAddress(uint64_t address);
+// Every draw before it is prepared (render thread): its first colour target and whether it blends.
+// True: the HUD-less copy is to be taken now (CaptureHudless).
+[[nodiscard]] bool HudlessDraw(uint64_t address, uint32_t width, uint32_t height, bool blended);
+// The display buffer `source` (outside rendering, in `layout` with `access`, both restored).
+void CaptureHudless(VkCommandBuffer cmd, VkImage source, VkFormat format, uint32_t width, uint32_t height,
+                    VkImageLayout layout, VkAccessFlags access, uint64_t address);
+// The copy could not be taken (the display buffer's image is not usable as it is).
+void HudlessUnavailable();
+// Present thread, while the present's commands are recorded: the token of the frame it shows.
+void SetPresentHudless(uint64_t token);
+
+// Swapchain (presentation/window/swapchain.cpp). CreateSwapchain: false leaves the normal path.
+[[nodiscard]] bool CreateSwapchain(const VkSwapchainCreateInfoKHR& info, VkSwapchainKHR* swapchain);
+[[nodiscard]] bool OwnsSwapchain(VkSwapchainKHR swapchain);
+void DestroySwapchain(VkSwapchainKHR swapchain);
+VkResult GetSwapchainImages(VkSwapchainKHR swapchain, uint32_t* count, VkImage* images);
+VkResult AcquireNextImage(VkSwapchainKHR swapchain, uint64_t timeout, VkSemaphore semaphore, VkFence fence,
+                          uint32_t* index);
+VkResult QueuePresent(VkQueue queue, const VkPresentInfoKHR* present);
+
+} // namespace Libs::Graphics::Fsr
+
+#endif // EMULATOR_SRC_GRAPHICS_HOST_GPU_RENDERER_FSR_H_
