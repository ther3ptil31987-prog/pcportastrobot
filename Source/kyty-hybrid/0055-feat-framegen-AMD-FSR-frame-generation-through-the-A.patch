+// ---- Device. ----
+
+uint32_t ExtraQueues(uint32_t family_queue_count, uint32_t used) {
+	if (!FrameGenRequested()) {
+		return 0;
+	}
+	if (family_queue_count < used + 3) {
+		std::printf("FSR FG: frame generation needs 3 more queues of the graphics family (it has %u, %u in use): off\n",
+		            family_queue_count, used);
+		std::fflush(stdout);
+		return 0;
+	}
+	return 3;
+}
+
+void OnDeviceReady(const DeviceInfo& info) {
+	auto& s  = Get();
+	s.device = info;
+	if (!FrameGenRequested()) {
+		return;
+	}
+	if (!LoadFfx()) {
+		return;
+	}
+	if (FrameGenRequested()) {
+		if (info.extra_count == 3) {
+			s.frame_gen_active.store(true, std::memory_order_release);
+			std::printf("FSR FG: frame generation on, queues %p (game) %p %p %p of family %u\n",
+			            reinterpret_cast<void*>(info.game_queue), reinterpret_cast<void*>(info.extra_queues[0]),
+			            reinterpret_cast<void*>(info.extra_queues[1]), reinterpret_cast<void*>(info.extra_queues[2]),
+			            info.queue_family);
+		} else {
+			std::printf("FSR FG: frame generation off (no extra queues)\n");
+		}
+		std::fflush(stdout);
+	}
+}
+
+// ---- Frame generation. ----
+
+bool FrameGenActive() {
+	return Get().frame_gen_active.load(std::memory_order_acquire);
+}
+
+void RenderSubmitted(uint64_t frame) {
+	Get().cp_frame.store(frame, std::memory_order_release);
+}
+
+uint64_t CurrentFrame() {
+	return Get().cp_frame.load(std::memory_order_acquire) + 1;
+}
+
+bool CameraWanted() {
+	auto& s = Get();
+	return FrameGenActive() && s.camera_wanted.load(std::memory_order_acquire);
+}
+
+void SetCamera(const float* constants) {
+	auto& s = Get();
+	if (!CameraWanted()) {
+		return;
+	}
+	std::scoped_lock lock(s.camera_mutex);
+	std::memcpy(s.projection.data(), constants, sizeof(s.projection));
+	std::memcpy(s.view.data(), constants + 16, sizeof(s.view));
+	if (!s.camera_valid) {
+		std::printf("FSR FG: camera projection m[5]=%.5f m[10]=%.6f m[14]=%.6f m[11]=%.1f\n",
+		            static_cast<double>(s.projection[5]), static_cast<double>(s.projection[10]),
+		            static_cast<double>(s.projection[14]), static_cast<double>(s.projection[11]));
+		std::fflush(stdout);
+	}
+	s.camera_valid = true;
+	s.camera_wanted.store(false, std::memory_order_release);
+}
+
+bool TagFrame(VkCommandBuffer cmd, const FrameGen::ImageInput& depth, const FrameGen::ImageInput& motion,
+              const float jitter_uv[2], uint32_t width, uint32_t height) {
+	auto& s = Get();
+	if (!FrameGenActive() || cmd == VK_NULL_HANDLE) {
+		return false;
+	}
+	static bool reported = false;
+	if (!DepthSupported(depth.format) || ffxApiGetSurfaceFormatVK(motion.format) == FFX_API_SURFACE_FORMAT_UNKNOWN ||
+	    depth.width != width || depth.height != height || motion.width != width || motion.height != height) {
+		if (!reported) {
+			reported = true;
+			std::printf("FSR FG: inputs not usable: depth format %d %ux%u, motion format %d %ux%u, pass %ux%u\n",
+			            static_cast<int>(depth.format), depth.width, depth.height, static_cast<int>(motion.format),
+			            motion.width, motion.height, width, height);
+			std::fflush(stdout);
+		}
+		return false;
+	}
+	const uint64_t   frame = CurrentFrame();
+	std::scoped_lock lock(s.slot_mutex);
+	auto&            slot = s.slots[frame % SLOT_COUNT];
+	if (slot.valid && slot.frame == frame) {
+		return true; // the first upscale pass of the frame
+	}
+	slot.valid = false;
+	if (!PrepareSlot(slot, width, height, motion.format)) {
+		return false;
+	}
+	CopyDepth(cmd, depth, slot);
+	CopyMotion(cmd, motion, slot);
+	const auto now  = NowNs();
+	slot.frame_ms   = s.tag_ns == 0 ? 16.7f
+	                                : std::clamp(static_cast<float>(static_cast<double>(now - s.tag_ns) / 1e6), 1.0f, 250.0f);
+	s.tag_ns        = now;
+	slot.jitter[0]  = s.jitter_sign * jitter_uv[0] * static_cast<float>(width);
+	slot.jitter[1]  = s.jitter_sign * jitter_uv[1] * static_cast<float>(height);
+	FillCamera(slot);
+	slot.frame = frame;
+	slot.valid = true;
+	if (!reported) {
+		reported = true;
+		std::printf("FSR FG: frame inputs %ux%u, depth format %d, motion format %d\n", width, height,
+		            static_cast<int>(depth.format), static_cast<int>(motion.format));
+		std::fflush(stdout);
+	}
+	s.tags.fetch_add(1, std::memory_order_relaxed);
+	return true;
+}
+
+void PresentStart(uint64_t frame) {
+	auto&            s = Get();
+	std::scoped_lock lock(s.context_mutex);
+	s.present_generated = false;
+	if (s.swapchain_context == nullptr || frame == 0 || frame == s.configured_frame) {
+		return; // a present without a new frame keeps the last configuration
+	}
+	uint32_t render_width = 0, render_height = 0;
+	{
+		std::scoped_lock slots(s.slot_mutex);
+		const auto&      slot = s.slots[frame % SLOT_COUNT];
+		if (slot.valid && slot.frame == frame) {
+			render_width  = slot.width;
+			render_height = slot.height;
+		}
+	}
+	if (render_width != 0) {
+		EnsureFrameGenContext(render_width, render_height);
+	}
+	if (s.frame_gen_context == nullptr) {
+		return;
+	}
+	ffxConfigureDescFrameGeneration config {};
+	config.header.type             = FFX_API_CONFIGURE_DESC_TYPE_FRAMEGENERATION;
+	config.swapChain               = reinterpret_cast<void*>(s.swapchain);
+	config.frameGenerationCallback = &FrameGenerationCallback;
+	config.frameGenerationEnabled  = true;
+	config.allowAsyncWorkloads     = s.async;
+	config.flags = s.debug ? FFX_FRAMEGENERATION_FLAG_DRAW_DEBUG_VIEW | FFX_FRAMEGENERATION_FLAG_DRAW_DEBUG_TEAR_LINES
+	                       : 0u;
+	config.onlyPresentGenerated = false;
+	config.generationRect       = {0, 0, static_cast<int32_t>(s.display.width), static_cast<int32_t>(s.display.height)};
+	config.frameID              = frame;
+	// The presented frame without its HUD (fsr.h), when one was taken for it at this size.
+	const auto hud = std::exchange(s.present_hud, HudImage {});
+	if (hud.image != VK_NULL_HANDLE && hud.width == s.display.width && hud.height == s.display.height &&
+	    hud.format == s.display_format) {
+		config.HUDLessColor = Resource(hud.image, ffxApiGetSurfaceFormatVK(hud.format), hud.width, hud.height,
+		                               FFX_API_RESOURCE_USAGE_READ_ONLY, FFX_API_RESOURCE_STATE_COMPUTE_READ);
+		s.hud_used++;
+	}
+	ffxReturnCode_t result      = FFX_API_RETURN_OK;
+	if (s.first_configure) {
+		// Turning interpolation on waits for the queues to be idle.
+		QueueScope queue;
+		result = s.configure(&s.frame_gen_context, &config.header);
+	} else {
+		result = s.configure(&s.frame_gen_context, &config.header);
+	}
+	if (result != FFX_API_RETURN_OK) {
+		LogError("frame generation configure", result);
+		return;
+	}
+	s.first_configure  = false;
+	s.configured_frame = frame;
+}
+
+void PresentEnd(uint64_t) {
+	auto&            s = Get();
+	std::scoped_lock lock(s.context_mutex);
+	if (s.swapchain_context == nullptr) {
+		return;
+	}
+	s.presents++;
+	const double shown = s.present_generated ? 2.0 : 1.0;
+	const double old   = s.shown_ratio.load(std::memory_order_relaxed);
+	s.shown_ratio.store(old + (shown - old) * 0.1, std::memory_order_relaxed);
+	Summary();
+}
+
+double ShownPerGameFrame() {
+	return FrameGenActive() ? Get().shown_ratio.load(std::memory_order_relaxed) : 1.0;
+}
+
+// ---- Swapchain. ----
+
+bool CreateSwapchain(const VkSwapchainCreateInfoKHR& info, VkSwapchainKHR* swapchain) {
+	auto& s = Get();
+	if (!FrameGenActive() || swapchain == nullptr) {
+		return false;
+	}
+	std::scoped_lock lock(s.context_mutex);
+	if (s.swapchain_context != nullptr) {
+		std::printf("FSR FG: a second swapchain is created normally\n");
+		return false;
+	}
+	const auto queue = [&](VkQueue handle, PFN_vkQueueSubmitFFXAPI submit) {
+		VkQueueInfoFFXAPI q {};
+		q.queue       = handle;
+		q.familyIndex = s.device.queue_family;
+		q.submitFunc  = submit;
+		return q;
+	};
+	VkSwapchainKHR handle              = VK_NULL_HANDLE;
+	s.swapchain_desc                   = {};
+	s.swapchain_desc.header.type       = FFX_API_CREATE_CONTEXT_DESC_TYPE_FGSWAPCHAIN_VK;
+	s.swapchain_desc.physicalDevice    = s.device.physical_device;
+	s.swapchain_desc.device            = s.device.device;
+	s.swapchain_desc.swapchain         = &handle;
+	s.swapchain_desc.allocator         = nullptr;
+	s.swapchain_desc.createInfo        = info;
+	s.swapchain_desc.gameQueue         = queue(s.device.game_queue, &SubmitGameQueue);
+	s.swapchain_desc.asyncComputeQueue = queue(s.device.extra_queues[0], nullptr);
+	s.swapchain_desc.presentQueue      = queue(s.device.extra_queues[1], nullptr);
+	s.swapchain_desc.imageAcquireQueue = queue(s.device.extra_queues[2], nullptr);
+	s.swapchain_version                = {};
+	s.swapchain_version.header.type    = FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATIONSWAPCHAIN_VERSION_VK;
+	s.swapchain_version.version        = FFX_FRAMEGENERATION_SWAPCHAIN_VK_VERSION;
+	s.swapchain_desc.header.pNext      = &s.swapchain_version.header;
+	ffxReturnCode_t result             = FFX_API_RETURN_OK;
+	{
+		QueueScope queue_lock;
+		result = s.create(&s.swapchain_context, &s.swapchain_desc.header, nullptr);
+	}
+	s.swapchain_desc.swapchain = nullptr;
+	if (result != FFX_API_RETURN_OK || handle == VK_NULL_HANDLE) {
+		s.swapchain_context = nullptr;
+		std::printf("FSR FG: frame generation swapchain creation failed (%u): normal swapchain\n",
+		            static_cast<unsigned>(result));
+		std::fflush(stdout);
+		return false;
+	}
+	s.functions             = {};
+	s.functions.header.type = FFX_API_QUERY_DESC_TYPE_FGSWAPCHAIN_FUNCTIONS_VK;
+	result                  = s.query(&s.swapchain_context, &s.functions.header);
+	if (result != FFX_API_RETURN_OK || s.functions.pOutGetSwapchainImagesKHR == nullptr ||
+	    s.functions.pOutAcquireNextImageKHR == nullptr || s.functions.pOutQueuePresentKHR == nullptr) {
+		std::printf("FSR FG: swapchain replacement functions unavailable (%u): normal swapchain\n",
+		            static_cast<unsigned>(result));
+		std::fflush(stdout);
+		QueueScope queue_lock;
+		(void)s.destroy(&s.swapchain_context, nullptr);
+		s.swapchain_context = nullptr;
+		return false;
+	}
+	s.swapchain        = handle;
+	s.display          = info.imageExtent;
+	s.display_format   = info.imageFormat;
+	s.display_hdr      = info.imageColorSpace != VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+	s.frame_gen_failed = false;
+	s.configured_frame = 0;
+	s.generated_frame  = 0;
+	s.hud_display_width.store(info.imageExtent.width, std::memory_order_relaxed);
+	s.hud_display_height.store(info.imageExtent.height, std::memory_order_relaxed);
+	s.hud_display_format.store(static_cast<uint32_t>(info.imageFormat), std::memory_order_release);
+	*swapchain         = handle;
+	std::printf("FSR FG: frame generation swapchain %ux%u, format %d, %u images, present mode %d\n", info.imageExtent.width,
+	            info.imageExtent.height, static_cast<int>(info.imageFormat), info.minImageCount,
+	            static_cast<int>(info.presentMode));
+	std::fflush(stdout);
+	return true;
+}
+
+bool OwnsSwapchain(VkSwapchainKHR swapchain) {
+	auto& s = Get();
+	return swapchain != VK_NULL_HANDLE && s.swapchain == swapchain;
+}
+
+void DestroySwapchain(VkSwapchainKHR swapchain) {
+	auto&            s = Get();
+	std::scoped_lock lock(s.context_mutex);
+	if (s.swapchain_context == nullptr || s.swapchain != swapchain) {
+		return;
+	}
+	QueueScope queue_lock;
+	ffxDispatchDescFrameGenerationSwapChainWaitForPresentsVK wait {};
+	wait.header.type = FFX_API_DISPATCH_DESC_TYPE_FGSWAPCHAIN_WAIT_FOR_PRESENTS_VK;
+	(void)s.dispatch(&s.swapchain_context, &wait.header);
+	DestroyFrameGenContext();
+	(void)s.destroy(&s.swapchain_context, nullptr);
+	s.swapchain_context = nullptr;
+	// SDK 2.x: the swapchain handle outlives its context and is destroyed through the replacement
+	// function afterwards (its context argument is unused).
+	if (s.functions.pOutDestroySwapchainFFXAPI != nullptr) {
+		s.functions.pOutDestroySwapchainFFXAPI(s.device.device, swapchain, nullptr, nullptr);
+	}
+	s.functions         = {};
+	s.swapchain         = VK_NULL_HANDLE;
+	s.configured_frame  = 0;
+	s.generated_frame   = 0;
+	s.present_hud       = {};
+	s.hud_display_format.store(0, std::memory_order_release);
+}
+
+// ---- HUD-less colour. ----
+
+uint64_t NoteDisplayFrame(uint64_t address, VkFormat frame_format, uint32_t width, uint32_t height) {
+	auto& s = Get();
+	if (!s.hud_enabled || !FrameGenActive() || address == 0) {
+		return 0;
+	}
+	if (std::find(s.hud_addresses.begin(), s.hud_addresses.end(), address) == s.hud_addresses.end()) {
+		s.hud_addresses[s.hud_address_next++ % s.hud_addresses.size()] = address;
+	}
+	s.hud_frame_format   = frame_format;
+	s.hud_frame_width    = width;
+	s.hud_frame_height   = height;
+	const uint64_t token = s.hud_captured != 0 && s.hud_captured_address == address ? s.hud_captured : 0;
+	LogFrameTail(address, width, height, token != 0);
+	s.hud_captured       = 0;
+	s.hud_opaque_address = 0;
+	s.hud_tried          = false;
+	s.hud_run_total      = 0;
+	return token;
+}
+
+bool DisplayAddress(uint64_t address) {
+	const auto& s = Get();
+	return address != 0 && std::find(s.hud_addresses.begin(), s.hud_addresses.end(), address) != s.hud_addresses.end();
+}
+
+bool HudlessDraw(uint64_t address, uint32_t width, uint32_t height, bool blended) {
+	auto& s = Get();
+	if (!s.hud_enabled || !FrameGenActive()) {
+		return false;
+	}
+	const bool display = std::find(s.hud_addresses.begin(), s.hud_addresses.end(), address) != s.hud_addresses.end();
+	HudRun*    run     = s.hud_run_total != 0 ? &s.hud_runs[(s.hud_run_total - 1) % HUD_RUNS] : nullptr;
+	if (run == nullptr || run->address != address) {
+		run          = &s.hud_runs[s.hud_run_total++ % HUD_RUNS];
+		*run         = {};
+		run->address = address;
+		run->width   = width;
+		run->height  = height;
+		run->display = display;
+	}
+	(blended ? run->blended : run->opaque)++;
+	if (!display || s.hud_tried) {
+		return false;
+	}
+	if (!blended) {
+		s.hud_opaque_address = address;
+		return false;
+	}
+	if (s.hud_opaque_address != address) {
+		return false;
+	}
+	// The first blended draw over the picture the last full-screen pass left: the HUD starts.
+	s.hud_tried = true;
+	run->copy   = true;
+	return true;
+}
+
+void HudlessUnavailable() {
+	Get().hud_unavailable.fetch_add(1, std::memory_order_relaxed);
+}
+
+void CaptureHudless(VkCommandBuffer cmd, VkImage source, VkFormat format, uint32_t width, uint32_t height,
+                    VkImageLayout layout, VkAccessFlags access, uint64_t address) {
+	auto&          s              = Get();
+	auto&          d              = VULKAN_HPP_DEFAULT_DISPATCHER;
+	const uint32_t display_width  = s.hud_display_width.load(std::memory_order_relaxed);
+	const uint32_t display_height = s.hud_display_height.load(std::memory_order_relaxed);
+	const auto     display_format = static_cast<VkFormat>(s.hud_display_format.load(std::memory_order_acquire));
+	if (cmd == VK_NULL_HANDLE || source == VK_NULL_HANDLE || display_format == VK_FORMAT_UNDEFINED ||
+	    display_width == 0 || display_height == 0 || s.hud_frame_format == VK_FORMAT_UNDEFINED ||
+	    width != s.hud_frame_width || height != s.hud_frame_height || layout == VK_IMAGE_LAYOUT_UNDEFINED) {
+		HudlessUnavailable();
+		return;
+	}
+	// The presenter copies the display buffer into a frame of its own format (no conversion) and
+	// scales that into the swapchain image: the same two steps, the first one only when the
+	// formats differ, give the same pixels wherever the HUD does not draw.
+	const bool direct = format == s.hud_frame_format;
+	if (!direct && !EnsureHudImage(s.hud_source, s.hud_frame_format, width, height)) {
+		HudlessUnavailable();
+		return;
+	}
+	HudImage target;
+	uint32_t index = 0;
+	{
+		std::scoped_lock lock(s.hud_mutex);
+		index      = s.hud_next;
+		s.hud_next = (s.hud_next + 1) % HUD_COUNT;
+		auto& slot = s.hud_ring[index];
+		slot.serial = 0;
+		if (!EnsureHudImage(slot, display_format, display_width, display_height)) {
+			HudlessUnavailable();
+			return;
+		}
+		target = slot;
+	}
+	Barrier(cmd, source, VK_IMAGE_ASPECT_COLOR_BIT, layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, access,
+	        VK_ACCESS_TRANSFER_READ_BIT);
+	VkImage from = source;
+	if (!direct) {
+		Barrier(cmd, s.hud_source.image, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED,
+		        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 0, VK_ACCESS_TRANSFER_WRITE_BIT);
+		VkImageCopy copy {};
+		copy.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+		copy.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+		copy.extent         = {width, height, 1};
+		d.vkCmdCopyImage(cmd, source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, s.hud_source.image,
+		                 VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+		Barrier(cmd, s.hud_source.image, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+		        VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+		from = s.hud_source.image;
+	}
+	Barrier(cmd, target.image, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED,
+	        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 0, VK_ACCESS_TRANSFER_WRITE_BIT);
+	VkImageBlit blit {};
+	blit.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+	blit.srcOffsets[1]  = {static_cast<int32_t>(width), static_cast<int32_t>(height), 1};
+	blit.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+	blit.dstOffsets[1]  = {static_cast<int32_t>(display_width), static_cast<int32_t>(display_height), 1};
+	d.vkCmdBlitImage(cmd, from, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, target.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+	                 1, &blit, VK_FILTER_LINEAR);
+	Barrier(cmd, target.image, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+	        VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT);
+	Barrier(cmd, source, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, layout,
+	        VK_ACCESS_TRANSFER_READ_BIT, access);
+	{
+		std::scoped_lock lock(s.hud_mutex);
+		auto&            slot = s.hud_ring[index];
+		slot.serial           = ++s.hud_serial;
+		slot.address          = address;
+		s.hud_captured        = slot.serial;
+		s.hud_captured_address = address;
+	}
+	s.hud_copies.fetch_add(1, std::memory_order_relaxed);
+}
+
+void SetPresentHudless(uint64_t token) {
+	auto&    s = Get();
+	HudImage found {};
+	if (token != 0) {
+		std::scoped_lock lock(s.hud_mutex);
+		for (const auto& slot: s.hud_ring) {
+			if (slot.serial == token) {
+				found = slot;
+			}
+		}
+	}
+	s.present_hud = found;
+}
+
+VkResult GetSwapchainImages(VkSwapchainKHR swapchain, uint32_t* count, VkImage* images) {
+	auto& s = Get();
+	return s.functions.pOutGetSwapchainImagesKHR(s.device.device, swapchain, count, images);
+}
+
+VkResult AcquireNextImage(VkSwapchainKHR swapchain, uint64_t timeout, VkSemaphore semaphore, VkFence fence,
+                          uint32_t* index) {
+	auto& s = Get();
+	return s.functions.pOutAcquireNextImageKHR(s.device.device, swapchain, timeout, semaphore, fence, index);
+}
+
+VkResult QueuePresent(VkQueue queue, const VkPresentInfoKHR* present) {
+	return Get().functions.pOutQueuePresentKHR(queue, present);
+}
+
+#endif
+
+} // namespace Libs::Graphics::Fsr
