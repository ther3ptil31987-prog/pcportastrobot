+namespace {
+// The cache images of the display buffers (render thread, under the render mutex).
+struct HudTarget {
+	uint64_t address = 0;
+	ImageId  image {};
+};
+std::array<HudTarget, 4> g_hud_targets {};
+uint32_t                 g_hud_target_next = 0;
+} // namespace
+
+void RenderExecutor::NoteHudlessTarget(const RenderColorInfo& color) {
+	const uint64_t address = color.desc.info.data.address;
+	if (!color.image_id || !Fsr::DisplayAddress(address)) {
+		return;
+	}
+	for (auto& target: g_hud_targets) {
+		if (target.address == address) {
+			target.image = color.image_id;
+			return;
+		}
+	}
+	g_hud_targets[g_hud_target_next++ % g_hud_targets.size()] = {address, color.image_id};
+}
+
+void RenderExecutor::NoteHudlessDraw(CommandBuffer& buffer) {
+	const auto& registers = buffer.GetRegisters();
+	if ((registers.GetRenderTargetMask() & 0xfu) == 0) {
+		return;
+	}
+	const auto&    target  = registers.GetRenderTarget(0);
+	const uint64_t address = target.base.addr;
+	if (address == 0) {
+		return;
+	}
+	// A blend that replaces the target (one, zero) is not one.
+	const auto& blend   = registers.GetBlendControl(0);
+	const bool  blended = blend.enable && !(blend.color_srcblend == 1 && blend.color_destblend == 0);
+	if (!Fsr::HudlessDraw(address, target.attrib2.width + 1u, target.attrib2.height + 1u, blended)) {
+		return;
+	}
+	Image* image = nullptr;
+	for (const auto& known: g_hud_targets) {
+		if (known.address == address && known.image) {
+			image = m_context.GetTextureCache().m_slot_images.try_get(known.image);
+		}
+	}
+	if (image == nullptr || image->backing.image == nullptr || image->info.data.address != address ||
+	    image->info.samples != 1 || image->backing.layers != 1 || !image->backing.subresource_states.empty() ||
+	    image->backing.state.layout == vk::ImageLayout::eUndefined) {
+		Fsr::HudlessUnavailable();
+		return;
+	}
+	// Nothing of the draw is prepared yet: the copy is recorded between two rendering instances,
+	// with barriers of its own that leave the image in the state the cache tracks.
+	buffer.EndRendering();
+	const auto cmd    = buffer.Handle();
+	const auto access = static_cast<uint64_t>(static_cast<VkAccessFlags2>(image->backing.state.access_mask));
+	Fsr::CaptureHudless(static_cast<VkCommandBuffer>(cmd), static_cast<VkImage>(image->backing.image),
+	                    static_cast<VkFormat>(image->backing.format), image->backing.extent.width,
+	                    image->backing.extent.height, static_cast<VkImageLayout>(image->backing.state.layout),
+	                    static_cast<VkAccessFlags>(access & 0xffffffffull) |
+	                        ((access >> 32) != 0 ? VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT : 0u),
+	                    address);
+	// No draw-run record is continued across it.
+	m_run.valid        = false;
+	m_run_prev_valid   = false;
+	m_run_keepable     = false;
+	m_run_active       = false;
+	m_run_targets_kept = false;
+	for (auto& record: m_run_kept) {
+		record.valid = false;
+	}
+}
