+	std::array<uint64_t, 4>         hud_addresses {}; // the display buffers flipped lately
+	uint32_t                        hud_address_next = 0;
+	VkFormat                        hud_frame_format = VK_FORMAT_UNDEFINED; // the presenter's frame
+	uint32_t                        hud_frame_width = 0, hud_frame_height = 0;
+	uint64_t                        hud_opaque_address = 0; // since the last flip: an unblended draw there
+	bool                            hud_tried          = false;
+	uint64_t                        hud_captured       = 0; // since the last flip: the copy's token
+	uint64_t                        hud_captured_address = 0;
+	std::mutex                      hud_mutex; // the ring's entries (render and present threads)
+	std::array<HudImage, HUD_COUNT> hud_ring {};
+	uint32_t                        hud_next   = 0;
+	uint64_t                        hud_serial = 0;
+	HudImage                        hud_source;
+	std::vector<HudImage>           hud_retired; // replaced by another size; freed with the process
+	HudImage                        present_hud; // present thread: the next present's
+	std::atomic<uint64_t>           hud_copies {0}, hud_unavailable {0};
+	uint64_t                        hud_used = 0; // context_mutex
+	std::array<HudRun, HUD_RUNS>    hud_runs {};
+	uint32_t                        hud_run_total = 0;
+	std::array<uint64_t, 16>        hud_tails {}; // frame ends already described in the log
+	uint32_t                        hud_tail_count = 0;
+
+	// Camera (camera_mutex).
+	std::mutex            camera_mutex;
+	std::atomic<bool>     camera_wanted {true};
+	bool                  camera_valid = false;
+	std::array<float, 16> projection {};
+	std::array<float, 16> view {};
+
+	// Statistics (present thread, except the atomics).
+	std::atomic<uint64_t>                                  tags {0};
+	uint64_t                                               presents = 0, generated = 0;
+	std::array<uint64_t, static_cast<size_t>(Skip::Count)> skips {};
+	std::atomic<double>                                    shown_ratio {1.0};
+	int64_t                                                print_ns = 0;
+	uint32_t                                               errors_logged = 0;
+};
+
+State& Get() {
+	static State state;
+	return state;
+}
+
+thread_local int t_queue_locked = 0;
+
+// The game queue is externally synchronized by GraphicContext::queue_mutex.
+struct QueueScope {
+	QueueScope() {
+		if (t_queue_locked++ == 0 && Get().device.queue_lock != nullptr) {
+			Get().device.queue_lock(true);
+		}
+	}
+	~QueueScope() {
+		if (--t_queue_locked == 0 && Get().device.queue_lock != nullptr) {
+			Get().device.queue_lock(false);
+		}
+	}
+	QueueScope(const QueueScope&)            = delete;
+	QueueScope& operator=(const QueueScope&) = delete;
+};
+
+VkResult SubmitGameQueue(uint32_t count, const VkSubmitInfo* submits, VkFence fence) {
+	QueueScope lock;
+	return VULKAN_HPP_DEFAULT_DISPATCHER.vkQueueSubmit(Get().device.game_queue, count, submits, fence);
+}
+
+// FSR's Vulkan backend asks for some functions by their extension names (it calls
+// vkGetBufferMemoryRequirements2KHR without a null check when the GPU supports dedicated
+// allocations). Kyty's device has them as core Vulkan 1.1+ functions without those extensions
+// enabled, so the loader answers null for the KHR name: the core name is tried then.
+PFN_vkVoidFunction VKAPI_CALL DeviceProcAddr(VkDevice device, const char* name) {
+	const auto real     = VULKAN_HPP_DEFAULT_DISPATCHER.vkGetDeviceProcAddr;
+	auto       function = real(device, name);
+	if (function == nullptr && name != nullptr) {
+		const size_t length = std::strlen(name);
+		if (length > 3 && std::strcmp(name + length - 3, "KHR") == 0) {
+			const std::string core(name, length - 3);
+			function = real(device, core.c_str());
+		}
+	}
+	return function;
+}
+
+int64_t NowNs() {
+	return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+	    .count();
+}
+
+void Message(uint32_t type, const wchar_t* message) {
+	auto& s = Get();
+	if (s.errors_logged < 40) {
+		s.errors_logged++;
+		std::printf("FSR FG runtime %s: %ls\n", type == FFX_API_MESSAGE_TYPE_ERROR ? "error" : "warning", message);
+		std::fflush(stdout);
+	}
+}
+
+std::string ModuleFolder() {
+	HMODULE self = nullptr;
+	char    path[MAX_PATH] {};
+	if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+	                       reinterpret_cast<LPCSTR>(&ModuleFolder), &self) == 0 ||
+	    GetModuleFileNameA(self, path, MAX_PATH) == 0) {
+		return ".";
+	}
+	std::string text(path);
+	const auto  slash = text.find_last_of("\\/");
+	return slash == std::string::npos ? std::string(".") : text.substr(0, slash);
+}
+
+bool LoadFfx() {
+	auto& s = Get();
+	if (s.library_tried) {
+		return s.dispatch != nullptr;
+	}
+	s.library_tried        = true;
+	const char*       path = std::getenv("ASTROHYBRID_FSR_PATH");
+	const std::string folder = path != nullptr && path[0] != '\0' ? std::string(path) : ModuleFolder();
+	const std::string dll    = folder + "\\amd_fidelityfx_loader_vk.dll";
+	// The effect itself: the loader looks for it next to the game's executable and next to itself.
+	const std::string effect = folder + "\\amd_fidelityfx_framegeneration_vk.dll";
+	if (GetFileAttributesA(effect.c_str()) == INVALID_FILE_ATTRIBUTES) {
+		std::printf("FSR FG: %s is missing: off\n", effect.c_str());
+		std::fflush(stdout);
+		return false;
+	}
+	// The same loader as FSR upscaling (fsr.inc) when both are on: one module, separate contexts.
+	s.module = LoadLibraryExA(dll.c_str(), nullptr, LOAD_WITH_ALTERED_SEARCH_PATH);
+	if (s.module == nullptr) {
+		std::printf("FSR FG: cannot load %s (%lu): off\n", dll.c_str(), GetLastError());
+		std::fflush(stdout);
+		return false;
+	}
+	const auto symbol = [&](const char* name) { return reinterpret_cast<void*>(GetProcAddress(s.module, name)); };
+	s.create    = reinterpret_cast<PfnFfxCreateContext>(symbol("ffxCreateContext"));
+	s.destroy   = reinterpret_cast<PfnFfxDestroyContext>(symbol("ffxDestroyContext"));
+	s.configure = reinterpret_cast<PfnFfxConfigure>(symbol("ffxConfigure"));
+	s.query     = reinterpret_cast<PfnFfxQuery>(symbol("ffxQuery"));
+	auto dispatch = reinterpret_cast<PfnFfxDispatch>(symbol("ffxDispatch"));
+	if (s.create == nullptr || s.destroy == nullptr || s.configure == nullptr || s.query == nullptr ||
+	    dispatch == nullptr) {
+		std::printf("FSR FG: %s lacks an entry point: off\n", dll.c_str());
+		std::fflush(stdout);
+		return false;
+	}
+	s.dispatch = dispatch;
+	if (const char* value = std::getenv("ASTROHYBRID_FSR_DEPTH_INVERTED"); value != nullptr) {
+		s.depth_inverted = std::strcmp(value, "0") != 0;
+	} else if (const char* dlss = std::getenv("ASTROHYBRID_DLSS_DEPTH_INVERTED"); dlss != nullptr) {
+		s.depth_inverted = std::strcmp(dlss, "0") != 0;
+	}
+	if (const char* value = std::getenv("ASTROHYBRID_DLSS_JITTER_SIGN"); value != nullptr) {
+		s.jitter_sign = std::strtof(value, nullptr) < 0 ? -1.0f : 1.0f;
+	}
+	s.async       = !EnvIs("ASTROHYBRID_FSRFG_ASYNC", "0");
+	s.debug       = EnvIs("ASTROHYBRID_FSRFG_DEBUG", "1");
+	s.hud_enabled = !EnvIs("ASTROHYBRID_FSRFG_HUD", "0");
+	ffxConfigureDescGlobalDebug debug {};
+	debug.header.type = FFX_API_CONFIGURE_DESC_TYPE_GLOBALDEBUG;
+	debug.effectId    = FFX_API_EFFECT_ID_FRAMEGENERATION;
+	debug.fpMessage   = &Message;
+	debug.debugLevel  = FFX_API_CONFIGURE_GLOBALDEBUG_LEVEL_WARNINGS;
+	(void)s.configure(nullptr, &debug.header);
+	std::printf("FSR FG: %s loaded (depth inverted %d, jitter sign %+.0f)\n", dll.c_str(), s.depth_inverted ? 1 : 0,
+	            static_cast<double>(s.jitter_sign));
+	std::fflush(stdout);
+	return true;
+}
