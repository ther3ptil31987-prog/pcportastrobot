+
+// ---- Vulkan helpers (Kyty's dispatcher: the loader's functions, no prototypes). ----
+
+void Barrier(VkCommandBuffer cmd, VkImage image, VkImageAspectFlags aspect, VkImageLayout from, VkImageLayout to,
+             VkAccessFlags source_access, VkAccessFlags destination_access) {
+	VkImageMemoryBarrier barrier {};
+	barrier.sType               = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+	barrier.srcAccessMask       = source_access;
+	barrier.dstAccessMask       = destination_access;
+	barrier.oldLayout           = from;
+	barrier.newLayout           = to;
+	barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	barrier.image               = image;
+	barrier.subresourceRange    = {aspect, 0, 1, 0, 1};
+	VULKAN_HPP_DEFAULT_DISPATCHER.vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+	                                                   VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0, nullptr,
+	                                                   1, &barrier);
+}
+
+bool Allocate(const VkMemoryRequirements& requirements, VkDeviceMemory& memory) {
+	auto&                            s = Get();
+	auto&                            d = VULKAN_HPP_DEFAULT_DISPATCHER;
+	VkPhysicalDeviceMemoryProperties properties {};
+	d.vkGetPhysicalDeviceMemoryProperties(s.device.physical_device, &properties);
+	for (uint32_t i = 0; i < properties.memoryTypeCount; i++) {
+		if ((requirements.memoryTypeBits & (1u << i)) != 0 &&
+		    (properties.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) != 0) {
+			VkMemoryAllocateInfo info {};
+			info.sType           = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+			info.allocationSize  = requirements.size;
+			info.memoryTypeIndex = i;
+			if (d.vkAllocateMemory(s.device.device, &info, nullptr, &memory) == VK_SUCCESS) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+bool CreateImage(VkFormat format, uint32_t width, uint32_t height, VkImage& image, VkDeviceMemory& memory) {
+	auto&             s = Get();
+	auto&             d = VULKAN_HPP_DEFAULT_DISPATCHER;
+	VkImageCreateInfo info {};
+	info.sType         = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+	info.imageType     = VK_IMAGE_TYPE_2D;
+	info.format        = format;
+	info.extent        = {width, height, 1};
+	info.mipLevels     = 1;
+	info.arrayLayers   = 1;
+	info.samples       = VK_SAMPLE_COUNT_1_BIT;
+	info.tiling        = VK_IMAGE_TILING_OPTIMAL;
+	info.usage         = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+	info.sharingMode   = VK_SHARING_MODE_EXCLUSIVE;
+	info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+	if (d.vkCreateImage(s.device.device, &info, nullptr, &image) != VK_SUCCESS) {
+		return false;
+	}
+	VkMemoryRequirements requirements {};
+	d.vkGetImageMemoryRequirements(s.device.device, image, &requirements);
+	return Allocate(requirements, memory) && d.vkBindImageMemory(s.device.device, image, memory, 0) == VK_SUCCESS;
+}
+
+bool CreateBuffer(VkDeviceSize size, VkBuffer& buffer, VkDeviceMemory& memory) {
+	auto&              s = Get();
+	auto&              d = VULKAN_HPP_DEFAULT_DISPATCHER;
+	VkBufferCreateInfo info {};
+	info.sType       = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+	info.size        = size;
+	info.usage       = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+	info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+	if (d.vkCreateBuffer(s.device.device, &info, nullptr, &buffer) != VK_SUCCESS) {
+		return false;
+	}
+	VkMemoryRequirements requirements {};
+	d.vkGetBufferMemoryRequirements(s.device.device, buffer, &requirements);
+	return Allocate(requirements, memory) && d.vkBindBufferMemory(s.device.device, buffer, memory, 0) == VK_SUCCESS;
+}
+
+bool DepthSupported(VkFormat format) {
+	return format == VK_FORMAT_D32_SFLOAT || format == VK_FORMAT_D32_SFLOAT_S8_UINT;
+}
+
+VkImageAspectFlags DepthLayoutAspect(VkFormat format) {
+	return format == VK_FORMAT_D32_SFLOAT_S8_UINT ? VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT
+	                                               : VK_IMAGE_ASPECT_DEPTH_BIT;
+}
+
+// The slot's images for this render size and motion format (motion VK_FORMAT_UNDEFINED: depth
+// only). The game's render size changes while playing (dynamic resolution), so the images only
+// grow: a smaller frame uses their top-left part. Replaced images are retired, not destroyed: a
+// submitted command buffer may still read them.
+bool PrepareSlot(Slot& slot, uint32_t width, uint32_t height, VkFormat motion_format) {
+	auto&              s    = Get();
+	const VkDeviceSize size = static_cast<VkDeviceSize>(width) * height * 4;
+	if (s.staging == VK_NULL_HANDLE || s.staging_size < size) {
+		// The old buffer (if any) stays alive for the command buffers that use it.
+		s.staging        = VK_NULL_HANDLE;
+		s.staging_memory = VK_NULL_HANDLE;
+		if (!CreateBuffer(size, s.staging, s.staging_memory)) {
+			s.staging = VK_NULL_HANDLE;
+			std::printf("FSR FG: cannot create the %ux%u depth staging buffer\n", width, height);
+			std::fflush(stdout);
+			return false;
+		}
+		s.staging_size = size;
+	}
+	if (slot.depth != VK_NULL_HANDLE && slot.image_width >= width && slot.image_height >= height &&
+	    slot.motion_format == motion_format) {
+		slot.width  = width;
+		slot.height = height;
+		return true;
+	}
+	const uint32_t image_width  = std::max(width, slot.image_width);
+	const uint32_t image_height = std::max(height, slot.image_height);
+	if (slot.depth != VK_NULL_HANDLE) {
+		s.retired.push_back(slot);
+	}
+	slot               = Slot {};
+	slot.width         = width;
+	slot.height        = height;
+	slot.image_width   = image_width;
+	slot.image_height  = image_height;
+	slot.motion_format = motion_format;
+	const bool ok = CreateImage(VK_FORMAT_R32_SFLOAT, image_width, image_height, slot.depth, slot.depth_memory) &&
+	                (motion_format == VK_FORMAT_UNDEFINED ||
+	                 CreateImage(motion_format, image_width, image_height, slot.motion, slot.motion_memory));
+	if (!ok) {
+		std::printf("FSR FG: cannot create the %ux%u input copies\n", image_width, image_height);
+		std::fflush(stdout);
+		slot.depth = VK_NULL_HANDLE;
+	}
+	return ok;
+}
+
+// The depth aspect into the slot's R32F image, through the staging buffer (a depth-to-colour image
+// copy needs VK_KHR_maintenance8). The source is in `layout` and is left in it.
+void CopyDepth(VkCommandBuffer cmd, const FrameGen::ImageInput& depth, Slot& slot) {
+	auto&      d       = VULKAN_HPP_DEFAULT_DISPATCHER;
+	const auto staging = Get().staging;
+	const auto aspect  = DepthLayoutAspect(depth.format);
+	Barrier(cmd, depth.image, aspect, depth.layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_ACCESS_SHADER_READ_BIT,
+	        VK_ACCESS_TRANSFER_READ_BIT);
+	VkBufferImageCopy region {};
+	region.imageSubresource = {VK_IMAGE_ASPECT_DEPTH_BIT, 0, 0, 1};
+	region.imageExtent      = {slot.width, slot.height, 1};
+	d.vkCmdCopyImageToBuffer(cmd, depth.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, staging, 1, &region);
+	Barrier(cmd, depth.image, aspect, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, depth.layout, VK_ACCESS_TRANSFER_READ_BIT,
+	        VK_ACCESS_SHADER_READ_BIT);
+	VkBufferMemoryBarrier buffer_barrier {};
+	buffer_barrier.sType               = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER;
+	buffer_barrier.srcAccessMask       = VK_ACCESS_TRANSFER_WRITE_BIT;
+	buffer_barrier.dstAccessMask       = VK_ACCESS_TRANSFER_READ_BIT;
+	buffer_barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	buffer_barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	buffer_barrier.buffer              = staging;
+	buffer_barrier.size                = VK_WHOLE_SIZE;
+	d.vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 1,
+	                       &buffer_barrier, 0, nullptr);
+	Barrier(cmd, slot.depth, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+	        0, VK_ACCESS_TRANSFER_WRITE_BIT);
+	region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+	d.vkCmdCopyBufferToImage(cmd, staging, slot.depth, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+	Barrier(cmd, slot.depth, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+	        VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT);
+}
+
+void CopyMotion(VkCommandBuffer cmd, const FrameGen::ImageInput& motion, Slot& slot) {
+	auto& d = VULKAN_HPP_DEFAULT_DISPATCHER;
+	Barrier(cmd, motion.image, VK_IMAGE_ASPECT_COLOR_BIT, motion.layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+	        VK_ACCESS_SHADER_READ_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+	Barrier(cmd, slot.motion, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+	        0, VK_ACCESS_TRANSFER_WRITE_BIT);
+	VkImageCopy region {};
+	region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+	region.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+	region.extent         = {slot.width, slot.height, 1};
+	d.vkCmdCopyImage(cmd, motion.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, slot.motion,
+	                 VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+	Barrier(cmd, motion.image, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, motion.layout,
+	        VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_SHADER_READ_BIT);
+	Barrier(cmd, slot.motion, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+	        VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT);
+}
+
+// The camera of the frame being rendered into the slot (the game's per-view constants: the
+// projection, then the view matrix, row-major with row vectors, as frameGen.cpp reads them).
+void FillCamera(Slot& slot) {
+	auto&            s = Get();
+	std::scoped_lock lock(s.camera_mutex);
+	if (s.camera_valid) {
+		const auto& p = s.projection;
+		const auto& v = s.view;
+		const float a = p[10];
+		const float b = p[14];
+		const float near_plane = a != 0.0f ? std::fabs(b / a) : 0.1f;
+		const float far_plane  = a + 1.0f != 0.0f ? std::fabs(b / (a + 1.0f)) : 1000.0f;
+		if (std::isfinite(near_plane) && std::isfinite(far_plane) && near_plane > 0.0f && far_plane > 0.0f) {
+			slot.camera_near = std::min(near_plane, far_plane);
+			slot.camera_far  = std::max(near_plane, far_plane);
+		}
+		if (p[5] > 0.0f) {
+			slot.camera_fov = 2.0f * std::atan(1.0f / p[5]);
+		}
+		// The view matrix is a rotation and a translation: its inverse's rows are the camera's
+		// axes and position in world space.
+		for (int i = 0; i < 3; i++) {
+			slot.camera_right[i]    = v[i * 4 + 0];
+			slot.camera_up[i]       = v[i * 4 + 1];
+			slot.camera_forward[i]  = -v[i * 4 + 2];
+			slot.camera_position[i] = -(v[12] * v[i * 4 + 0] + v[13] * v[i * 4 + 1] + v[14] * v[i * 4 + 2]);
+		}
+	}
+	s.camera_wanted.store(true, std::memory_order_release);
+}
+
+// ---- HUD-less colour. ----
+
+// The image in this format and size. A replaced image is retired, not destroyed: a submitted
+// command buffer may still use it.
+bool EnsureHudImage(HudImage& image, VkFormat format, uint32_t width, uint32_t height) {
+	auto& s = Get();
+	if (image.image != VK_NULL_HANDLE && image.format == format && image.width == width && image.height == height) {
+		return true;
+	}
+	if (image.image != VK_NULL_HANDLE) {
+		s.hud_retired.push_back(image);
+	}
+	image = {};
+	if (!CreateImage(format, width, height, image.image, image.memory)) {
+		image = {};
+		return false;
+	}
+	image.format = format;
+	image.width  = width;
+	image.height = height;
+	return true;
+}
+
+// Once per kind of frame end: the last colour targets drawn into before the flip, with their
+// unblended (o) and blended (b) draws, the display buffers (D) and where the copy was taken.
+void LogFrameTail(uint64_t address, uint32_t width, uint32_t height, bool copied) {
+	auto&          s     = Get();
+	const uint32_t first = s.hud_run_total > HUD_RUNS ? s.hud_run_total - HUD_RUNS : 0;
+	uint64_t       hash  = 1469598103934665603ull;
+	const auto     mix   = [&hash](uint64_t value) { hash = (hash ^ value) * 1099511628211ull; };
+	for (uint32_t i = first; i < s.hud_run_total; i++) {
+		const auto& run = s.hud_runs[i % HUD_RUNS];
+		mix((static_cast<uint64_t>(run.width) << 32) | run.height);
+		mix((run.display ? 1u : 0u) | (run.opaque != 0 ? 2u : 0u) | (run.blended != 0 ? 4u : 0u) | (run.copy ? 8u : 0u));
+	}
+	mix(copied ? 3 : 2);
+	for (uint32_t i = 0; i < s.hud_tail_count; i++) {
+		if (s.hud_tails[i] == hash) {
+			return;
+		}
+	}
+	if (s.hud_tail_count >= s.hud_tails.size()) {
+		return;
+	}
+	s.hud_tails[s.hud_tail_count++] = hash;
+	std::string text;
+	for (uint32_t i = first; i < s.hud_run_total; i++) {
+		const auto& run = s.hud_runs[i % HUD_RUNS];
+		char        part[96];
+		std::snprintf(part, sizeof(part), "%s%s%ux%u o%u b%u%s", text.empty() ? "" : " > ", run.display ? "D " : "",
+		              run.width, run.height, run.opaque, run.blended, run.copy ? " (copy)" : "");
+		text += part;
+	}
+	std::printf("FSR FG: frame end before the flip of %llx (%ux%u), HUD-less copy %s: %s\n",
+	            static_cast<unsigned long long>(address), width, height, copied ? "taken" : "not taken",
+	            text.empty() ? "no draws" : text.c_str());
+	std::fflush(stdout);
+}
+
+void LogError(const char* what, ffxReturnCode_t code) {
+	auto& s = Get();
+	if (s.errors_logged < 40) {
+		s.errors_logged++;
+		std::printf("FSR FG: %s failed (%u)\n", what, static_cast<unsigned>(code));
+		std::fflush(stdout);
+	}
+}
+
+// ---- Frame generation (context_mutex held). ----
+
+// Frame generation is turned off on the swapchain first (that waits for the interpolation and
+// composition work that uses the context), then the context is destroyed.
+void DestroyFrameGenContext() {
+	auto& s = Get();
+	if (s.frame_gen_context != nullptr) {
+		ffxConfigureDescFrameGeneration off {};
+		off.header.type            = FFX_API_CONFIGURE_DESC_TYPE_FRAMEGENERATION;
+		off.swapChain              = reinterpret_cast<void*>(s.swapchain);
+		off.frameGenerationEnabled = false;
+		(void)s.configure(&s.frame_gen_context, &off.header);
+		(void)s.destroy(&s.frame_gen_context, nullptr);
+		s.frame_gen_context = nullptr;
+	}
+}
+
+void EnsureFrameGenContext(uint32_t render_width, uint32_t render_height) {
+	auto& s = Get();
+	if (s.swapchain_context == nullptr || s.frame_gen_failed) {
+		return;
+	}
+	const uint32_t max_width  = std::max(s.display.width, render_width);
+	const uint32_t max_height = std::max(s.display.height, render_height);
+	if (s.frame_gen_context != nullptr && s.frame_gen_desc.maxRenderSize.width >= render_width &&
+	    s.frame_gen_desc.maxRenderSize.height >= render_height) {
+		return;
+	}
+	if (s.frame_gen_context != nullptr) {
+		// A larger render size: nothing of the old context may be in flight.
+		QueueScope                                           queue;
+		ffxDispatchDescFrameGenerationSwapChainWaitForPresentsVK wait {};
+		wait.header.type = FFX_API_DISPATCH_DESC_TYPE_FGSWAPCHAIN_WAIT_FOR_PRESENTS_VK;
+		(void)s.dispatch(&s.swapchain_context, &wait.header);
+		DestroyFrameGenContext();
+	}
+	s.frame_gen_backend                                = {};
+	s.frame_gen_backend.header.type                    = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_VK;
+	s.frame_gen_backend.deviceContext.vkDevice         = s.device.device;
+	s.frame_gen_backend.deviceContext.vkPhysicalDevice = s.device.physical_device;
+	s.frame_gen_backend.deviceContext.vkDeviceProcAddr = &DeviceProcAddr;
+	// Since SDK 2.1 the version structure is required (without it the newer API is refused).
+	s.frame_gen_version              = {};
+	s.frame_gen_version.header.type  = FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION_VERSION;
+	s.frame_gen_version.header.pNext = &s.frame_gen_backend.header;
+	s.frame_gen_version.version      = FFX_FRAMEGENERATION_VERSION;
+	s.frame_gen_desc                 = {};
+	s.frame_gen_desc.header.type     = FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION;
+	s.frame_gen_desc.header.pNext    = &s.frame_gen_version.header;
+	s.frame_gen_desc.flags = FFX_FRAMEGENERATION_ENABLE_ASYNC_WORKLOAD_SUPPORT |
+	                         FFX_FRAMEGENERATION_ENABLE_MOTION_VECTORS_JITTER_CANCELLATION |
+	                         (s.depth_inverted ? FFX_FRAMEGENERATION_ENABLE_DEPTH_INVERTED : 0u) |
+	                         (s.display_hdr ? FFX_FRAMEGENERATION_ENABLE_HIGH_DYNAMIC_RANGE : 0u) |
+	                         (s.debug ? FFX_FRAMEGENERATION_ENABLE_DEBUG_CHECKING : 0u);
+	s.frame_gen_desc.displaySize      = {s.display.width, s.display.height};
+	s.frame_gen_desc.maxRenderSize    = {max_width, max_height};
+	s.frame_gen_desc.backBufferFormat = ffxApiGetSurfaceFormatVK(s.display_format);
+	const auto result                 = s.create(&s.frame_gen_context, &s.frame_gen_desc.header, nullptr);
+	if (result != FFX_API_RETURN_OK) {
+		s.frame_gen_context = nullptr;
+		s.frame_gen_failed  = true;
+		std::printf("FSR FG: frame generation context creation failed (%u) for display %ux%u, render up to %ux%u: off\n",
+		            static_cast<unsigned>(result), s.display.width, s.display.height, max_width, max_height);
+	} else {
+		s.first_configure = true;
+		std::printf("FSR FG: frame generation context created, display %ux%u (format %d%s), render up to %ux%u, %s\n",
+		            s.display.width, s.display.height, static_cast<int>(s.display_format), s.display_hdr ? ", HDR" : "",
+		            max_width, max_height, s.async ? "async compute queue" : "game queue");
+	}
+	std::fflush(stdout);
+}
+
+// Without inputs for the presented frame the swapchain still shows whatever is in the output:
+// the real frame again.
+void CopyPresentColor(const ffxDispatchDescFrameGeneration& params) {
+	auto&      d      = VULKAN_HPP_DEFAULT_DISPATCHER;
+	const auto cmd    = static_cast<VkCommandBuffer>(params.commandList);
+	const auto source = reinterpret_cast<VkImage>(params.presentColor.resource);
+	const auto target = reinterpret_cast<VkImage>(params.outputs[0].resource);
+	if (cmd == VK_NULL_HANDLE || source == VK_NULL_HANDLE || target == VK_NULL_HANDLE) {
+		return;
+	}
+	Barrier(cmd, source, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+	        VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_ACCESS_SHADER_READ_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+	VkImageCopy region {};
+	region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+	region.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+	region.extent         = {params.presentColor.description.width, params.presentColor.description.height, 1};
+	d.vkCmdCopyImage(cmd, source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, target, VK_IMAGE_LAYOUT_GENERAL, 1, &region);
+	Barrier(cmd, source, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+	        VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_SHADER_READ_BIT);
+}
+
+// The swapchain's frame-generation callback: called inside QueuePresent on the present thread,
+// with the command buffer the interpolation is submitted in.
+ffxReturnCode_t FrameGenerationCallback(ffxDispatchDescFrameGeneration* params, void*) {
+	auto&            s = Get();
+	std::scoped_lock lock(s.context_mutex);
+	Skip             skip  = Skip::Count;
+	Slot             frame {};
+	if (s.frame_gen_context == nullptr) {
+		skip = Skip::NoContext;
+	} else if (params->frameID == s.generated_frame) {
+		skip = Skip::Repeat;
+	} else {
+		std::scoped_lock slots(s.slot_mutex);
+		const auto&      slot = s.slots[params->frameID % SLOT_COUNT];
+		if (slot.valid && slot.frame == params->frameID && slot.depth != VK_NULL_HANDLE &&
+		    slot.motion != VK_NULL_HANDLE) {
+			frame = slot;
+		} else {
+			skip = Skip::NoInputs;
+		}
+	}
+	if (skip == Skip::Count) {
+		ffxDispatchDescFrameGenerationPrepareV2 prepare {};
+		std::memcpy(prepare.cameraPosition, frame.camera_position, sizeof(prepare.cameraPosition));
+		std::memcpy(prepare.cameraUp, frame.camera_up, sizeof(prepare.cameraUp));
+		std::memcpy(prepare.cameraRight, frame.camera_right, sizeof(prepare.cameraRight));
+		std::memcpy(prepare.cameraForward, frame.camera_forward, sizeof(prepare.cameraForward));
+		prepare.header.type             = FFX_API_DISPATCH_DESC_TYPE_FRAMEGENERATION_PREPARE_V2;
+		// A gap in the frame IDs (a frame without inputs) resets the generation by itself.
+		prepare.reset                   = false;
+		prepare.frameID                 = params->frameID;
+		prepare.flags                   = s.debug ? FFX_FRAMEGENERATION_FLAG_DRAW_DEBUG_VIEW : 0u;
+		prepare.commandList             = params->commandList;
+		prepare.renderSize              = {frame.width, frame.height};
+		prepare.jitterOffset            = {frame.jitter[0], frame.jitter[1]};
+		prepare.motionVectorScale       = {-static_cast<float>(frame.width), -static_cast<float>(frame.height)};
+		prepare.frameTimeDelta          = frame.frame_ms;
+		prepare.cameraNear              = frame.camera_near;
+		prepare.cameraFar               = frame.camera_far;
+		prepare.cameraFovAngleVertical  = frame.camera_fov;
+		prepare.viewSpaceToMetersFactor = 1.0f;
+		prepare.depth = Resource(frame.depth, FFX_API_SURFACE_FORMAT_R32_FLOAT, frame.image_width, frame.image_height,
+		                         FFX_API_RESOURCE_USAGE_READ_ONLY, FFX_API_RESOURCE_STATE_COMPUTE_READ);
+		prepare.motionVectors = Resource(frame.motion, ffxApiGetSurfaceFormatVK(frame.motion_format),
+		                                 frame.image_width, frame.image_height, FFX_API_RESOURCE_USAGE_READ_ONLY,
+		                                 FFX_API_RESOURCE_STATE_COMPUTE_READ);
+		if (const auto result = s.dispatch(&s.frame_gen_context, &prepare.header); result != FFX_API_RETURN_OK) {
+			LogError("frame generation prepare", result);
+			skip = Skip::Prepare;
+		} else if (const auto generated = s.dispatch(&s.frame_gen_context, &params->header);
+		           generated != FFX_API_RETURN_OK) {
+			LogError("frame generation dispatch", generated);
+			skip = Skip::Dispatch;
+		}
+	}
+	if (skip != Skip::Count) {
+		s.skips[static_cast<size_t>(skip)]++;
+		CopyPresentColor(*params);
+	} else {
+		s.generated_frame   = params->frameID;
+		s.present_generated = true;
+		s.generated++;
+	}
+	return FFX_API_RETURN_OK;
+}
+
+// What this process has allocated on the video card's own heaps and what the driver lets it have
+// (VK_EXT_memory_budget; zeros without it): a session that slows down as it goes on shows here.
+void VideoMemory(uint64_t& used, uint64_t& budget) {
+	auto& s = Get();
+	VkPhysicalDeviceMemoryBudgetPropertiesEXT budgets {};
+	budgets.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT;
+	VkPhysicalDeviceMemoryProperties2 properties {};
+	properties.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_PROPERTIES_2;
+	properties.pNext = &budgets;
+	VULKAN_HPP_DEFAULT_DISPATCHER.vkGetPhysicalDeviceMemoryProperties2(s.device.physical_device, &properties);
+	used = budget = 0;
+	for (uint32_t i = 0; i < properties.memoryProperties.memoryHeapCount; i++) {
+		if ((properties.memoryProperties.memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) != 0) {
+			used += budgets.heapUsage[i];
+			budget += budgets.heapBudget[i];
+		}
+	}
+}
+
+void Summary() {
+	auto&      s   = Get();
+	const auto now = NowNs();
+	if (s.print_ns == 0) {
+		s.print_ns = now;
+		return;
+	}
+	if (now - s.print_ns < 10'000'000'000LL) {
+		return;
+	}
+	s.print_ns = now;
+	std::string text;
+	for (size_t i = 0; i < s.skips.size(); i++) {
+		if (s.skips[i] != 0) {
+			text += " " + std::string(SKIP_NAMES[i]) + "=" + std::to_string(s.skips[i]);
+		}
+	}
+	Slot last {};
+	{
+		std::scoped_lock slots(s.slot_mutex);
+		last = s.slots[s.configured_frame % SLOT_COUNT];
+	}
+	uint64_t video_used = 0, video_budget = 0;
+	VideoMemory(video_used, video_budget);
+	std::printf("FSR FG 10s: %llu game presents, %llu generated (%.2f shown per game frame) | not generated:%s | "
+	            "inputs %llu, %ux%u, jitter %.3f %.3f px, frame %.1f ms, camera near %.3f far %.1f vfov %.1f deg | "
+	            "HUD-less: %llu copies, %llu used, %llu unavailable | video memory %llu of %llu MiB\n",
+	            static_cast<unsigned long long>(s.presents), static_cast<unsigned long long>(s.generated),
+	            s.presents == 0 ? 1.0 : 1.0 + static_cast<double>(s.generated) / static_cast<double>(s.presents),
+	            text.empty() ? " none" : text.c_str(),
+	            static_cast<unsigned long long>(s.tags.exchange(0, std::memory_order_relaxed)), last.width, last.height,
+	            static_cast<double>(last.jitter[0]), static_cast<double>(last.jitter[1]),
+	            static_cast<double>(last.frame_ms), static_cast<double>(last.camera_near),
+	            static_cast<double>(last.camera_far), static_cast<double>(last.camera_fov) * 57.29577951308232,
+	            static_cast<unsigned long long>(s.hud_copies.exchange(0, std::memory_order_relaxed)),
+	            static_cast<unsigned long long>(s.hud_used),
+	            static_cast<unsigned long long>(s.hud_unavailable.exchange(0, std::memory_order_relaxed)),
+	            static_cast<unsigned long long>(video_used >> 20), static_cast<unsigned long long>(video_budget >> 20));
+	std::fflush(stdout);
+	s.hud_used = 0;
+	s.presents = s.generated = 0;
+	s.skips                  = {};
+}
