+++ b/core/libs/prx/libc/src/ArchiveStdio.cpp
@@ -0,0 +1,141 @@
+#include "prx/libc/include/FileStream.hpp"
+#include "prx/libc/include/AppArchive.hpp"
+
+#include <algorithm>
+#include <limits>
+
+bool FileStream::IsArchive() {
+    if (!_handle) return false;
+    const FileStreamLock lock(this);
+#ifdef _WIN32
+    const int descriptor = ::_fileno(_handle);
+#else
+    const int descriptor = ::fileno(_handle);
+#endif
+    const bool attached = AppArchiveDescriptor_nid_no_patch(descriptor, nullptr, nullptr);
+    if (attached && archiveDescriptor < 0) MarkArchive();
+    else if (!attached && archiveDescriptor >= 0) {
+        archiveDescriptor = -1;
+        archivePushback = EOF;
+        archiveEnd = false;
+        _guest.flags = 0x10;
+    }
+    return attached;
+}
+
+bool FileStream::RejectArchiveWrite() {
+    if (!IsArchive()) return false;
+    const FileStreamLock lock(this);
+    errno = 9;
+    SetError();
+    return true;
+}
+
+void FileStream::MarkArchive() {
+#ifdef _WIN32
+    archiveDescriptor = ::_fileno(GetHandle());
+#else
+    archiveDescriptor = ::fileno(GetHandle());
+#endif
+    _guest.flags = 4;
+    archiveEnd = false;
+    archivePushback = EOF;
+}
+
+void FileStream::DetachArchive() {
+    if (IsArchive()) AppArchiveDetach_nid_no_patch(std::exchange(archiveDescriptor, -1));
+    archivePushback = EOF;
+    archiveEnd = false;
+}
+
+std::size_t FileStream::ReadArchive(void* buffer, std::size_t bytes) {
+    if (bytes == 0 || archiveEnd) return 0;
+    std::size_t total = 0;
+    auto* output = static_cast<unsigned char*>(buffer);
+    if (archivePushback != EOF) {
+        *output++ = static_cast<unsigned char>(std::exchange(archivePushback, EOF));
+        total = 1;
+    }
+    if (total != bytes) {
+        const AppArchiveBuffer destination{output, bytes - total};
+        std::uint64_t done = 0;
+        try {
+            if (!AppArchiveDescriptorRead_nid_no_patch(archiveDescriptor, &destination, 1, nullptr, &done)) {
+                errno = 9;
+                SetError();
+                return total;
+            }
+        } catch (const std::runtime_error&) {
+            errno = 5;
+            SetError();
+            return total;
+        }
+        total += static_cast<std::size_t>(done);
+        if (total < bytes) archiveEnd = true;
+    }
+    SyncUnlockedStatus();
+    return total;
+}
+
+int FileStream::PeekArchive() {
+    if (archiveEnd) return EOF;
+    if (archivePushback != EOF) return archivePushback;
+    const auto position = TellArchive();
+    if (position < 0) return EOF;
+    unsigned char value = 0;
+    const AppArchiveBuffer destination{&value, 1};
+    std::uint64_t done = 0;
+    try {
+        if (!AppArchiveDescriptorRead_nid_no_patch(archiveDescriptor, &destination, 1, &position, &done)) {
+            errno = 9;
+            SetError();
+            return EOF;
+        }
+    } catch (const std::runtime_error&) {
+        errno = 5;
+        SetError();
+        return EOF;
+    }
+    if (done != 0) return value;
+    archiveEnd = true;
+    SyncUnlockedStatus();
+    return EOF;
+}
+
+int FileStream::UngetArchive(int value) {
+    if (value == EOF || archivePushback != EOF) return EOF;
+    archivePushback = static_cast<unsigned char>(value);
+    archiveEnd = false;
+    SyncUnlockedStatus();
+    return archivePushback;
+}
+
+std::int64_t FileStream::TellArchive() {
+    std::uint64_t position = 0;
+    if (!AppArchiveDescriptor_nid_no_patch(archiveDescriptor, nullptr, &position)) { errno = 9; return -1; }
+    if (position > static_cast<std::uint64_t>(std::numeric_limits<std::int64_t>::max())) { errno = 84; return -1; }
+    return static_cast<std::int64_t>(position) - (archivePushback == EOF ? 0 : 1);
+}
+
+int FileStream::FlushArchive() {
+    const bool end = archiveEnd;
+    const int result = SeekArchive(0, SEEK_CUR);
+    archiveEnd = end;
+    SyncUnlockedStatus();
+    return result;
+}
+
+int FileStream::SeekArchive(std::int64_t offset, int origin) {
+    if (origin != SEEK_SET && origin != SEEK_CUR && origin != SEEK_END) { errno = 22; return -1; }
+    if (origin == SEEK_CUR && archivePushback != EOF) {
+        if (offset == std::numeric_limits<std::int64_t>::min()) { errno = 22; return -1; }
+        --offset;
+    }
+    std::int64_t position = -1;
+    if (!AppArchiveDescriptorSeek_nid_no_patch(archiveDescriptor, offset, origin, &position)) { errno = 9; return -1; }
+    if (position < 0) { errno = 22; return -1; }
+    archivePushback = EOF;
+    archiveEnd = false;
+    SyncUnlockedStatus();
+    return 0;
+}
