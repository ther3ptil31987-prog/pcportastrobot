+    Check(fread_nid_postfix(bytes, 1, sizeof(bytes), stream) == sizeof(bytes) && feof_nid_postfix(stream) == 0);
+    Check(fclose_nid_postfix(stream) == 0);
+#ifdef _WIN32
+    stream = fopen_nid_postfix("/app0/param.sfx", "rb");
+    Check(stream != nullptr && freopen_nid_postfix("/app0/sce_sys", "rb", stream) == stream && stream->IsDirectory());
+    Check(fread_nid_postfix(bytes, 1, sizeof(bytes), stream) == 0 && ferror_nid_postfix(stream) != 0);
+    Check(fclose_nid_postfix(stream) == 0);
+#endif
+    std::error_code error;
+    Check(!std::filesystem::exists("app0/sce_sys/param.sfx", error));
+}
+
+void ConcurrentReads() {
+    auto* stream = fopen_nid_postfix("/app0/Loose.txt", "rb");
+    Check(stream != nullptr && setvbuf_nid_postfix(stream, nullptr, 2, 0) == 0);
+    const int descriptor = sceKernelOpen("/app0/Data/Big.bin", SCE_KERNEL_O_RDONLY, 0);
+    const int target = fileno_nid_postfix(stream);
+    Check(descriptor >= 0 && dup2_nid_postfix(descriptor, target) == target);
+    std::array<std::vector<char>, 4> parts;
+    std::vector<std::thread> threads;
+    for (auto& part : parts) threads.emplace_back([&, output = &part] {
+        for (;;) {
+            const int value = fgetc_nid_postfix(stream);
+            if (value == EOF) break;
+            output->push_back(static_cast<char>(value));
+        }
+    });
+    for (auto& thread : threads) thread.join();
+    std::array<std::size_t, 256> actual{}, expected{};
+    for (const auto& part : parts) for (unsigned char value : part) ++actual[value];
+    for (unsigned char value : AppArchiveFixture::Pattern(BigSize)) ++expected[value];
+    Check(actual == expected && ftell_nid_postfix(stream) == static_cast<std::int64_t>(BigSize) && ferror_nid_postfix(stream) == 0);
+    Check(fclose_nid_postfix(stream) == 0 && !AppArchiveDescriptor_nid_no_patch(target, nullptr, nullptr));
+    Check(sceKernelLseek(descriptor, 0, SEEK_CUR) == static_cast<std::int64_t>(BigSize) && sceKernelClose(descriptor) == 0);
+}
+
+}
+
+int main(int argc, char** argv) {
+    if (argc != 2) return 2;
+    const auto root = AppArchiveFixture::EnterFreshRoot("anyps5-archive-stdio");
+    { std::ofstream loose(root / "app0" / "Loose.txt"); loose << "disk"; }
+    const std::string mode = argv[1];
+    if (mode == "archive") {
+        const std::string scan = " -42 0x2a 077 12.5 word abc! 99 XYz";
+        AppArchiveFixture::WriteArchive(root / "app0.zar", {
+            {"sce_sys/param.sfx", {'P', 'A', 'R', 'A', 'M', 'S', 'F', 'X', '\0', static_cast<char>(0xff), '\n'}},
+            {"param.sfx", {'R', 'O', 'O', 'T', 'S', 'F', 'X', '!'}},
+            {"Data/Big.bin", AppArchiveFixture::Pattern(BigSize)},
+            {"data/prein/effects/odx/hero_respawn_icon_01.odxb", AppArchiveFixture::Pattern(131077)},
+            {"Data/Numeric.txt", {'4', '2', ' ', '3', '.', '5', ' ', '0', 'x', '1', '.', '8', 'p', '+', '2'}},
+            {"Data/Text.txt", {'[', 'a', 'b', 'c', ']', ' ', 'X', 'Y', 'Z', ' ', 'w', 'o', 'r', 'd'}},
+            {"Data/LongNumeric.txt", std::vector<char>(4097, '1')},
+            {"Data/LongString.txt", std::vector<char>(8192, 's')},
+            {"Data/Lines.txt", {'o', 'n', 'e', '\n', 't', 'w', 'o'}},
+            {"Data/Scan.txt", std::vector<char>(scan.begin(), scan.end())},
+            {"Data/Incomplete.txt", {'1', '0', '0', 'e', 'X'}},
+            {"Data/Empty", {}},
+            {"Loose.txt", {'z', 'a', 'r'}}
+        });
+        Reads();
+        Lines();
+        Scanning();
+        SharedDescriptors();
+        OpensAndReopens();
+        ConcurrentReads();
+    } else if (mode == "damaged") {
+        AppArchiveFixture::WriteArchive(root / "app0.zar", {{"param.sfx", AppArchiveFixture::Pattern(65536)}});
+        {
+            std::fstream archive(root / "app0.zar", std::ios::binary | std::ios::in | std::ios::out);
+            const char garbage[8] = {0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0};
+            archive.write(garbage, sizeof(garbage));
+        }
+        auto* stream = fopen_nid_postfix("/app0/param.sfx", "rb");
+        Check(stream != nullptr && stream->IsArchive());
+        char bytes[32]{};
+        Check(fread_nid_postfix(bytes, 1, sizeof(bytes), stream) == 0 && errno == 5);
+        Check(ferror_nid_postfix(stream) != 0 && feof_nid_postfix(stream) == 0 && ftell_nid_postfix(stream) == 0);
+        clearerr_nid_postfix(stream);
+        Check(fgetc_nid_postfix(stream) == EOF && errno == 5 && ferror_nid_postfix(stream) != 0 && feof_nid_postfix(stream) == 0);
+        clearerr_nid_postfix(stream);
+        int value = 0;
+        Check(fscanf_nid_postfix(stream, "%d", &value) == EOF && errno == 5 && ferror_nid_postfix(stream) != 0 && feof_nid_postfix(stream) == 0);
+        const int descriptor = fileno_nid_postfix(stream);
+        Check(fclose_nid_postfix(stream) == 0 && !AppArchiveDescriptor_nid_no_patch(descriptor, nullptr, nullptr));
+    } else if (mode == "plain") {
+        auto* stream = fopen_nid_postfix("/app0/Loose.txt", "rb");
+        Check(stream != nullptr && !stream->IsArchive());
+        char bytes[8]{};
+        Check(fread_nid_postfix(bytes, 1, sizeof(bytes), stream) == 4 && std::memcmp(bytes, "disk", 4) == 0);
+        Check(fclose_nid_postfix(stream) == 0);
+        Check(fopen_nid_postfix("/app0/sce_sys/param.sfx", "r") == nullptr && errno == 2);
+    } else return 2;
+    std::error_code error;
+    std::filesystem::current_path(std::filesystem::temp_directory_path(), error);
+    std::filesystem::remove_all(root, error);
+    return 0;
+}
