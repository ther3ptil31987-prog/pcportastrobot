index 0000000000..ef267cdb25
--- /dev/null
+++ b/core/libs/prx/libc/src/ArchiveScanning.cpp
@@ -0,0 +1,219 @@
+#include "prx/libc/include/ArchiveStdio.hpp"
+#include "prx/libc/include/FileStream.hpp"
+#include "prx/libc/include/General.hpp"
+#include "prx/libc/include/GuestArena.hpp"
+
+#include <array>
+#include <cctype>
+#include <clocale>
+#include <cstring>
+#include <limits>
+#include <string>
+
+namespace {
+
+class FieldReader {
+    FileStream* stream;
+    std::size_t limit;
+    std::size_t count = 0;
+
+public:
+    FieldReader(FileStream* file, std::size_t width) : stream(file), limit(width) {}
+    int Peek() { return count < limit ? stream->PeekArchive() : EOF; }
+    int Take() {
+        unsigned char value = 0;
+        if (count >= limit || stream->ReadArchive(&value, 1) != 1) return EOF;
+        ++count;
+        return value;
+    }
+    std::size_t Count() const { return count; }
+};
+
+void PutCharacter(char* target, char value) {
+    const GuestArena::HostWrite destination(target, 1);
+    if (!destination.Open()) throw std::runtime_error("archive scanf: buffer is not writable");
+    *target = value;
+}
+
+bool Digit(int value, unsigned base) {
+    if (value >= '0' && value <= '9') return static_cast<unsigned>(value - '0') < base;
+    return base == 16 && ((value >= 'a' && value <= 'f') || (value >= 'A' && value <= 'F'));
+}
+
+void Append(FieldReader& input, std::string& token) {
+    if (token.size() >= 4096) NotImplemented_nid_no_patch("archive scanf numeric field longer than 4096 bytes");
+    token.push_back(static_cast<char>(input.Take()));
+}
+
+bool Word(FieldReader& input, std::string& token, const char* word) {
+    for (; *word; ++word) {
+        if (std::tolower(input.Peek()) != *word) return false;
+        Append(input, token);
+    }
+    return true;
+}
+
+bool Integer(FieldReader& input, std::string& token, char conversion) {
+    if (input.Peek() == '+' || input.Peek() == '-') Append(input, token);
+    unsigned base = conversion == 'o' ? 8 : conversion == 'x' || conversion == 'X' || conversion == 'p' ? 16 : 10;
+    bool digits = false;
+    if (input.Peek() == '0') {
+        Append(input, token);
+        digits = true;
+        if (conversion == 'i') base = 8;
+        if ((base == 16 || conversion == 'i') && (input.Peek() == 'x' || input.Peek() == 'X')) {
+            Append(input, token);
+            base = 16;
+            digits = false;
+        }
+    }
+    while (Digit(input.Peek(), base)) { Append(input, token); digits = true; }
+    return digits;
+}
+
+bool Floating(FieldReader& input, std::string& token) {
+    if (input.Peek() == '+' || input.Peek() == '-') Append(input, token);
+    if (std::tolower(input.Peek()) == 'i') {
+        if (!Word(input, token, "inf")) return false;
+        return std::tolower(input.Peek()) != 'i' || Word(input, token, "inity");
+    }
+    if (std::tolower(input.Peek()) == 'n') return Word(input, token, "nan");
+    unsigned base = 10;
+    bool digits = false;
+    if (input.Peek() == '0') {
+        Append(input, token);
+        digits = true;
+        if (input.Peek() == 'x' || input.Peek() == 'X') {
+            Append(input, token);
+            base = 16;
+            digits = false;
+        }
+    }
+    while (Digit(input.Peek(), base)) { Append(input, token); digits = true; }
+    if (input.Peek() == '.') {
+        Append(input, token);
+        while (Digit(input.Peek(), base)) { Append(input, token); digits = true; }
+    }
+    if (!digits) return false;
+    const int exponent = base == 16 ? 'p' : 'e';
+    if (std::tolower(input.Peek()) != exponent) return true;
+    Append(input, token);
+    if (input.Peek() == '+' || input.Peek() == '-') Append(input, token);
+    digits = false;
+    while (Digit(input.Peek(), 10)) { Append(input, token); digits = true; }
+    return digits;
+}
+
+std::array<bool, 256> Scanset(const char* specifier) {
+    std::array<bool, 256> values{};
+    const auto* cursor = reinterpret_cast<const unsigned char*>(specifier + 1);
+    const bool inverse = *cursor == '^';
+    if (inverse) ++cursor;
+    if (*cursor == ']') values[*cursor++] = true;
+    while (*cursor && *cursor != ']') {
+        const unsigned char first = *cursor++;
+        if (*cursor == '-' && cursor[1] && cursor[1] != ']' && first <= cursor[1]) {
+            const unsigned char last = cursor[1];
+            cursor += 2;
+            for (unsigned value = first; value <= last; ++value) values[value] = true;
+        } else values[first] = true;
+    }
+    if (inverse) for (auto& value : values) value = !value;
+    return values;
+}
+
+}
+
+void RequireArchiveScan_nid_no_patch(const char* format) {
+    for (const char* cursor = format; *cursor;) {
+        if (*cursor++ != '%') continue;
+        if (*cursor == '%') { ++cursor; continue; }
+        if (*cursor == '*') ++cursor;
+        unsigned width = 0;
+        const bool hasWidth = std::isdigit(static_cast<unsigned char>(*cursor)) != 0;
+        while (std::isdigit(static_cast<unsigned char>(*cursor))) {
+            const auto digit = static_cast<unsigned>(*cursor++ - '0');
+            if (width > (static_cast<unsigned>(std::numeric_limits<int>::max()) - digit) / 10)
+                NotImplemented_nid_no_patch("archive scanf width exceeds INT_MAX");
+            width = width * 10 + digit;
+        }
+        if (hasWidth && width == 0) NotImplemented_nid_no_patch("archive scanf zero field width");
+        const char* start = cursor;
+        while (*cursor && std::strchr("hljztL", *cursor)) ++cursor;
+        const std::string length(start, cursor);
+        const char conversion = *cursor;
+        if (!conversion || !std::strchr("diouxXnpaAeEfFgGsc[", conversion))
+            NotImplemented_nid_no_patch("archive scanf positional, allocation or unknown conversion");
+        const bool number = std::strchr("diouxXn", conversion) != nullptr;
+        const bool floating = std::strchr("aAeEfFgG", conversion) != nullptr;
+        const bool valid = number ? length.empty() || length == "hh" || length == "h" || length == "l" || length == "ll" || length == "j" || length == "z" || length == "t"
+            : floating ? length.empty() || length == "l" || length == "L" : length.empty();
+        if (!valid) NotImplemented_nid_no_patch("archive scanf wide conversion or unsupported length");
+        if (floating && std::strcmp(std::localeconv()->decimal_point, ".") != 0)
+            NotImplemented_nid_no_patch("archive scanf non-dot decimal locale");
+#ifdef _WIN32
+        if (floating && length == "L") NotImplemented_nid_no_patch("archive scanf 80-bit long double on Windows");
+#endif
+        ++cursor;
+        if (conversion == '[') {
+            if (*cursor == '^') ++cursor;
+            if (*cursor == ']') ++cursor;
+            while (*cursor && *cursor != ']') ++cursor;
+            if (!*cursor) NotImplemented_nid_no_patch("archive scanf unterminated scanset");
+            ++cursor;
+        }
+    }
+}
+
+int ScanArchiveField_nid_no_patch(FileStream* stream, const char* directive, bool suppress, void* target, int* consumed) {
+    const char* cursor = directive + 1;
+    if (*cursor == '*') ++cursor;
+    std::size_t width = 0;
+    while (std::isdigit(static_cast<unsigned char>(*cursor))) {
+        const auto digit = static_cast<unsigned>(*cursor++ - '0');
+        if (width > (std::numeric_limits<std::size_t>::max() - digit) / 10) throw std::invalid_argument("archive scanf width overflow");
+        width = width * 10 + digit;
+    }
+    const char* lengthStart = cursor;
+    while (*cursor && std::strchr("hljztL", *cursor)) ++cursor;
+    const std::string length(lengthStart, cursor);
+    const char conversion = *cursor;
+    if (conversion == 'S' || conversion == 'C' || ((conversion == 's' || conversion == 'c' || conversion == '[') && !length.empty()))
+        NotImplemented_nid_no_patch("archive scanf wide character conversion");
+    if (!std::strchr("diouxXpaAeEfFgGsc[", conversion) || conversion == '\0')
+        NotImplemented_nid_no_patch("archive scanf conversion");
+    if (length != "" && length != "hh" && length != "h" && length != "l" && length != "ll" && length != "j" && length != "z" && length != "t" && length != "L")
+        NotImplemented_nid_no_patch("archive scanf length modifier");
+    const auto limit = width != 0 ? width : conversion == 'c' ? 1 : static_cast<std::size_t>(std::numeric_limits<int>::max());
+    FieldReader input(stream, limit);
+    const bool empty = input.Peek() == EOF;
+    if (conversion == 's' || conversion == 'c' || conversion == '[') {
+        const auto set = conversion == '[' ? Scanset(cursor) : std::array<bool, 256>{};
+        auto* output = static_cast<char*>(target);
+        while (input.Peek() != EOF) {
+            const int next = input.Peek();
+            if ((conversion == 's' && std::isspace(next)) || (conversion == '[' && !set[static_cast<unsigned char>(next)])) break;
+            const int value = input.Take();
+            if (value == EOF) break;
+            if (!suppress) PutCharacter(output++, static_cast<char>(value));
+        }
+        if (input.Count() == 0) return empty ? EOF : 0;
+        if (!suppress && conversion != 'c') PutCharacter(output, '\0');
+        *consumed = static_cast<int>(input.Count());
+        return suppress ? 0 : 1;
+    }
+    std::string token;
+    const bool valid = std::strchr("aAeEfFgG", conversion) ? Floating(input, token)
+        : conversion == 'p' && input.Peek() == '(' ? Word(input, token, "(nil)") : Integer(input, token, conversion);
+    if (!valid) return empty ? EOF : 0;
+    const std::size_t targetSize = conversion == 'p' ? sizeof(void*) : std::strchr("aAeEfFgG", conversion)
+        ? length == "L" ? sizeof(long double) : length == "l" ? sizeof(double) : sizeof(float)
+        : length == "hh" ? 1 : length == "h" ? sizeof(short) : length.empty() ? sizeof(int) : sizeof(std::int64_t);
+    const GuestArena::HostWrite destination(target, suppress ? 0 : targetSize);
+    if (!suppress && !destination.Open()) throw std::runtime_error("archive scanf: target is not writable");
+    int hostConsumed = -1;
+    const int result = suppress ? std::sscanf(token.c_str(), directive, &hostConsumed) : std::sscanf(token.c_str(), directive, target, &hostConsumed);
+    if (hostConsumed < 0 || static_cast<std::size_t>(hostConsumed) != token.size()) return 0;
+    *consumed = static_cast<int>(input.Count());
+    return result;
+}
