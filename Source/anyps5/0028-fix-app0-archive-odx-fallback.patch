+void OdxResolution(const std::filesystem::path& root) {
+    AppArchiveNode node{}, binary{};
+    Require(Lookup("/app0/param.sfx", node) && !node.Directory && node.Size == 3, "archive-only param.sfx was not found at the archive root");
+    Require(AppArchiveOnly_nid_no_patch(root / "app0/param.sfx"), "param.sfx was not archive-only");
+    char bytes[16]{};
+    Require(AppArchiveRead_nid_no_patch(node.Handle, 0, bytes, sizeof(bytes)) == 3 && std::memcmp(bytes, "sfx", 3) == 0, "param.sfx returned wrong bytes");
+    Require(Lookup("/app0/Assets/icons/hero_respawn_icon_01.odxb", binary), "the binary asset was not found exactly");
+    Require(Lookup("/APP0/assets/ICONS/HERO_RESPAWN_ICON_01.ODX", node) && !node.Directory && node.Handle == binary.Handle && node.Size == 6, "missing .odx did not select the case-insensitive .odxb file and size");
+    Require(AppArchiveRead_nid_no_patch(node.Handle, 0, bytes, sizeof(bytes)) == 6 && std::memcmp(bytes, "binary", 6) == 0, "the .odxb fallback returned wrong bytes");
+    Require(AppArchiveOnly_nid_no_patch(root / "app0/Assets/icons/hero_respawn_icon_01.odx"), "the .odx fallback was not archive-only");
+    Require(GuardRefuses("/app0/Assets/icons/hero_respawn_icon_01.odx"), "the generic resolver stopped refusing an aliased archive file");
+    Require(Lookup("/app0/Assets/Exact.odxb", binary), "the binary version of the exact asset was not found");
+    Require(Lookup("/app0/Assets/exact.ODX", node) && !node.Directory && node.Size == 3 && node.Handle != binary.Handle, "exact .odx did not win over .odxb");
+    Require(AppArchiveRead_nid_no_patch(node.Handle, 0, bytes, sizeof(bytes)) == 3 && std::memcmp(bytes, "odx", 3) == 0, "the exact .odx returned the binary version's bytes");
+    Require(Lookup("/app0/Assets/ExactDirectory.odx", node) && node.Directory && node.Size == 0, "an exact .odx directory was replaced by .odxb");
+    Require(!Lookup("/app0/Assets/Directory.odx", node), "a .odxb directory was aliased as a regular file");
+    Require(!Lookup("/app0/Assets/Intermediate.odx/Child.bin", node), "an intermediate path component was rewritten");
+    Require(!Lookup("/app0/Assets/Unrelated.txt", node), "an unrelated extension was rewritten");
+    Require(!Lookup("/app0/Assets/Unrelated.odx.bin", node), "a non-terminal .odx extension was rewritten");
+    Require(!Lookup("/app0/Assets/icons/hero_respawn_icon_01.odx/", node), "a trailing-slash directory request was aliased to a file");
+    Require(!Lookup("/app0/Assets/icons/hero_respawn_icon_01.odx/child", node), "a child of an aliased file was found");
+    Require(!Lookup("/Assets/icons/hero_respawn_icon_01.odx", node), "a path outside app0 was aliased");
+    Require(!Lookup("/app0x/Assets/icons/hero_respawn_icon_01.odx", node), "a sibling mount was aliased");
+    Require(Lookup("/app0/app0/Nested.bin", node) && node.Size == 1, "a valid nested app0 directory was refused");
+
+    const auto entries = AppArchiveListDirectory_nid_no_patch(root / "app0/Assets/icons");
+    Require(entries.size() == 1 && entries[0].Name == "hero_respawn_icon_01.odxb" && !entries[0].Directory && entries[0].Size == 6, "directory entries exposed an .odx alias");
+    std::filesystem::create_directories(root / "app0/Assets");
+    { std::ofstream file(root / "app0/Assets/Loose.odx"); file << "native"; }
+    { std::ofstream file(root / "app0/Assets/LooseExact.odx"); file << "native exact"; }
+    Require(!Lookup("/app0/Assets/Loose.odx", node), "an aliased archive file shadowed an exact native .odx");
+    Require(!AppArchiveOnly_nid_no_patch(root / "app0/Assets/Loose.odx"), "a loose .odx override was archive-only");
+    Require(!AppArchiveOnly_nid_no_patch(root / "app0/Assets/LooseExact.odx"), "an exact loose file was shadowed by an archive file");
+    Require(ResolvePath_nid_no_patch("/app0/Assets/Loose.odx") == root / "app0/Assets/Loose.odx", "a loose .odx override was refused");
+    Require(ResolvePath_nid_no_patch("/app0/Assets/LooseExact.odx") == root / "app0/Assets/LooseExact.odx", "an exact loose file was refused");
+    std::filesystem::create_directory(root / "app0/Assets/LooseDirectory.odx");
+    Require(!Lookup("/app0/Assets/LooseDirectory.odx", node) && !AppArchiveOnly_nid_no_patch(root / "app0/Assets/LooseDirectory.odx"), "a loose directory became an aliased regular file");
+    std::filesystem::create_directory(root / "app0/Assets/BinaryShadow.odxb");
+    Require(!Lookup("/app0/Assets/BinaryShadow.odx", node), "a shadowed .odxb directory became an aliased regular file");
+    std::filesystem::create_directory(root / "app0/Assets/CaseBinaryShadow.ODXB");
+    Require(!Lookup("/app0/Assets/CaseBinaryShadow.odx", node), "a case-insensitive loose .odxb directory did not shadow the alias");
+    { std::ofstream file(root / "app0/Assets/LooseBinary.odxb"); file << "native binary"; }
+    Require(!Lookup("/app0/Assets/LooseBinary.odx", node), "an archive alias bypassed a loose .odxb override");
+    Require(ResolvePath_nid_no_patch("/app0/Assets/LooseBinary.odxb") == root / "app0/Assets/LooseBinary.odxb", "a loose binary override was refused");
+}
