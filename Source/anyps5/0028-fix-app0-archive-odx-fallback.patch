@@ -42,8 +42,16 @@ Archive& Opened() {
     candidate += ".zar";
     std::error_code error;
     if (std::filesystem::is_regular_file(candidate, error)) {
-        archive.reader.reset(ZArchiveReader::OpenFromFile(candidate));
-        if (!archive.reader) throw std::runtime_error("app0.zar is not a readable ZArchive: " + candidate.string());
+        std::unique_ptr<ZArchiveReader> reader(ZArchiveReader::OpenFromFile(candidate));
+        if (!reader) throw std::runtime_error("app0.zar is not a readable ZArchive: " + candidate.string());
+        const auto root = reader->LookUp("");
+        if (reader->GetDirEntryCount(root) == 1) {
+            ZArchiveReader::DirEntry entry{};
+            if (!reader->GetDirEntry(root, 0, entry)) throw std::runtime_error("app0.zar is damaged: its root directory cannot be read");
+            if (entry.isDirectory && SameComponent(entry.name, "app0"))
+                throw std::runtime_error("app0.zar has a wrapped app0/ root: store app0's contents at the archive root, without an app0/ prefix: " + candidate.string());
+        }
+        archive.reader = std::move(reader);
         archive.path = candidate;
     }
     archive.app0 = app0;
@@ -69,6 +77,23 @@ bool ArchiveRelative(const Archive& archive, const std::filesystem::path& hostPa
     return true;
 }

+bool NativeShadows(const std::filesystem::path& path) {
+    std::error_code error;
+    const auto status = std::filesystem::symlink_status(path, error);
+    return std::filesystem::exists(status) || (error && error != std::errc::no_such_file_or_directory);
+}
+
+bool NativeNameShadows(const std::filesystem::path& path) {
+    if (NativeShadows(path)) return true;
+    std::error_code error;
+    std::filesystem::directory_iterator entry(path.parent_path(), error), end;
+    const auto name = path.filename().generic_string();
+    for (; !error && entry != end; entry.increment(error)) {
+        if (SameComponent(entry->path().filename().generic_string(), name)) return true;
+    }
+    return error && error != std::errc::no_such_file_or_directory;
+}
+
 struct OpenFile {
     AppArchiveNode node;
     std::uint64_t position = 0;
@@ -100,8 +125,18 @@ bool AppArchiveLookup_nid_no_patch(const std::filesystem::path& hostPath, AppArc
     if (!archive.reader) return false;
     std::string relative;
     if (!ArchiveRelative(archive, hostPath, relative)) return false;
-    const auto handle = archive.reader->LookUp(relative);
-    if (handle == ZARCHIVE_INVALID_NODE) return false;
+    auto handle = archive.reader->LookUp(relative);
+    if (handle == ZARCHIVE_INVALID_NODE) {
+        constexpr std::string_view suffix = ".odx";
+        if (relative.size() < suffix.size() || !SameComponent(std::string_view(relative).substr(relative.size() - suffix.size()), suffix) ||
+            !hostPath.has_filename() || NativeShadows(hostPath)) return false;
+        relative += 'b';
+        handle = archive.reader->LookUp(relative);
+        if (handle == ZARCHIVE_INVALID_NODE || !archive.reader->IsFile(handle)) return false;
+        auto binaryPath = hostPath;
+        binaryPath += 'b';
+        if (NativeNameShadows(binaryPath)) return false;
+    }
     node->Handle = handle;
     node->Directory = archive.reader->IsDirectory(handle);
     node->Size = node->Directory ? 0 : archive.reader->GetFileSize(handle);
@@ -190,9 +225,7 @@ std::filesystem::path AppArchivePath_nid_no_patch() {
 bool AppArchiveOnly_nid_no_patch(const std::filesystem::path& hostPath) {
     auto& archive = Opened();
     if (!archive.reader) return false;
-    std::error_code error;
-    const auto status = std::filesystem::symlink_status(hostPath, error);
-    if (std::filesystem::exists(status) || (error && error != std::errc::no_such_file_or_directory)) return false;
+    if (NativeShadows(hostPath)) return false;
     AppArchiveNode node{};
     return AppArchiveLookup_nid_no_patch(hostPath, &node);
 }
