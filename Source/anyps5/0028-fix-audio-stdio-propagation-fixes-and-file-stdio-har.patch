+#ifdef _WIN32
+static std::size_t BounceStreamTransfer(FILE* handle, void* buffer, std::size_t size, std::size_t count, std::size_t done, std::int64_t startPos, bool write) {
+    constexpr std::size_t chunkLimit = 64u * 1024u;
+    std::clearerr(handle);
+    if (startPos >= 0) {
+        if (::_fseeki64(handle, startPos + static_cast<std::int64_t>(done * size), SEEK_SET) != 0) return done;
+    }
+    const std::size_t perBatch = size <= chunkLimit ? (chunkLimit / size) : 1u;
+    std::vector<char> staging(perBatch * size);
+    while (done < count) {
+        const std::size_t batch = std::min(count - done, perBatch);
+        const std::size_t batchBytes = batch * size;
+        auto* target = static_cast<char*>(buffer) + done * size;
+        if (write) std::memcpy(staging.data(), target, batchBytes);
+        const std::size_t got = write ? std::fwrite(staging.data(), size, batch, handle)
+                                      : std::fread(staging.data(), size, batch, handle);
+        if (!write && got != 0) std::memcpy(target, staging.data(), got * size);
+        done += got;
+        if (got < batch) break;
+    }
+    return done;
+}
+#endif
