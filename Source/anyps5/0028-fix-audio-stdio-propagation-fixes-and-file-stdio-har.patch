+std::int64_t File::NativeDescriptorIo_nid_no_patch(int descriptor, void* buf, std::size_t nbytes, bool write) {
+    const auto handle = reinterpret_cast<HANDLE>(WithoutParameterHandler([descriptor] { return ::_get_osfhandle(descriptor); }));
+    LARGE_INTEGER savedPos{};
+    const bool hasSavedPos = handle != INVALID_HANDLE_VALUE && ::GetFileType(handle) == FILE_TYPE_DISK && ::SetFilePointerEx(handle, LARGE_INTEGER{}, &savedPos, FILE_CURRENT);
+    const int result = write ? ::_write(descriptor, buf, static_cast<unsigned int>(nbytes))
+                             : ::_read(descriptor, buf, static_cast<unsigned int>(nbytes));
+    if (result < 0 && nbytes != 0 && (_doserrno == ERROR_NOACCESS || ::GetLastError() == ERROR_NOACCESS)) {
+        if (hasSavedPos && !::SetFilePointerEx(handle, savedPos, nullptr, FILE_BEGIN)) {
+            errno = EIO;
+            return -1;
+        }
+        return BounceSequentialTransfer(descriptor, buf, nbytes, write);
+    }
+    if (!write && result < 0 && _doserrno == ERROR_NO_DATA) errno = EAGAIN;
+    if (write && result < 0 && handle != INVALID_HANDLE_VALUE && ::GetFileType(handle) == FILE_TYPE_PIPE) {
+        if (errno == ENOSPC && _doserrno == 0) errno = EAGAIN;
+        else if (_doserrno == ERROR_NO_DATA || _doserrno == ERROR_BROKEN_PIPE) errno = EPIPE;
+    }
+    return result;
+}
