+        // 2. Sequential read (read_nid_postfix -> NativeTransferBuffer) into PAGE_READONLY pages
+        faultBuffer.ProtectReadOnly();
+        Require(lseek_nid_postfix(fd, 5, 0) == 5, "cannot seek before sequential read");
+        const auto readCount = read_nid_postfix(fd, faultBuffer.Data(), FileBytes - 5u);
+        Require(readCount == static_cast<std::int64_t>(FileBytes - 5u), "read_nid_postfix on PAGE_READONLY failed");
+        Require(g_faultedPages >= 3, "read_nid_postfix did not trigger VEH on PAGE_READONLY pages");
+        VerifyPattern(faultBuffer.Data(), 5, FileBytes - 5u);
+        Require(close_nid_postfix(fd) == 0, "cannot close descriptor");
