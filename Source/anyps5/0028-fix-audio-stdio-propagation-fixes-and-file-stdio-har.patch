+static std::int64_t BounceSequentialTransfer(int descriptor, void* buf, std::size_t nbytes, bool write) {
+    constexpr std::size_t chunkLimit = 64u * 1024u;
+    std::vector<char> staging(std::min<std::size_t>(nbytes, chunkLimit));
+    std::size_t totalDone = 0;
+    while (totalDone < nbytes) {
+        const unsigned int chunk = static_cast<unsigned int>(std::min<std::size_t>(nbytes - totalDone, staging.size()));
+        if (write) std::memcpy(staging.data(), static_cast<const char*>(buf) + totalDone, chunk);
+        const int chunkDone = write ? ::_write(descriptor, staging.data(), chunk)
+                                    : ::_read(descriptor, staging.data(), chunk);
+        if (chunkDone < 0) return totalDone > 0 ? static_cast<std::int64_t>(totalDone) : -1;
+        if (!write && chunkDone > 0) std::memcpy(static_cast<char*>(buf) + totalDone, staging.data(), static_cast<std::size_t>(chunkDone));
+        totalDone += static_cast<std::size_t>(chunkDone);
+        if (chunkDone == 0 || static_cast<unsigned int>(chunkDone) < chunk) break;
+    }
+    return static_cast<std::int64_t>(totalDone);
+}
