+// Stage transfers through host memory when direct kernel I/O hits ERROR_NOACCESS
+// on GPU write/read-watched guest pages so user-mode VEH handlers can unprotect them.
+static bool BouncePositionedTransfer(HANDLE handle, void* buf, DWORD nbytes, std::uint64_t at, bool write, bool append, DWORD& done, DWORD& error) {
+    constexpr std::size_t chunkLimit = 64u * 1024u;
+    if (write && append) {
+        std::vector<char> staging(nbytes);
+        std::memcpy(staging.data(), buf, nbytes);
+        OVERLAPPED overlapped{};
+        overlapped.Offset = static_cast<DWORD>(at);
+        overlapped.OffsetHigh = static_cast<DWORD>(at >> 32u);
+        const BOOL ok = ::WriteFile(handle, staging.data(), nbytes, &done, &overlapped);
+        error = ok ? ERROR_SUCCESS : ::GetLastError();
+        return ok != FALSE;
+    }
+    std::vector<char> staging(std::min<std::size_t>(nbytes, chunkLimit));
+    DWORD totalDone = 0;
+    BOOL ok = TRUE;
+    error = ERROR_SUCCESS;
+    while (totalDone < nbytes) {
+        const DWORD chunk = static_cast<DWORD>(std::min<std::size_t>(nbytes - totalDone, staging.size()));
+        if (write) std::memcpy(staging.data(), static_cast<const char*>(buf) + totalDone, chunk);
+        OVERLAPPED chunkOverlapped{};
+        const std::uint64_t chunkAt = at + totalDone;
+        chunkOverlapped.Offset = static_cast<DWORD>(chunkAt);
+        chunkOverlapped.OffsetHigh = static_cast<DWORD>(chunkAt >> 32u);
+        DWORD chunkDone = 0;
+        ok = write ? ::WriteFile(handle, staging.data(), chunk, &chunkDone, &chunkOverlapped)
+                   : ::ReadFile(handle, staging.data(), chunk, &chunkDone, &chunkOverlapped);
+        error = ok ? ERROR_SUCCESS : ::GetLastError();
+        if (!write && chunkDone != 0) std::memcpy(static_cast<char*>(buf) + totalDone, staging.data(), chunkDone);
+        totalDone += chunkDone;
+        if (!ok || chunkDone < chunk) break;
+    }
+    done = totalDone;
+    if (!ok && !write && error == ERROR_HANDLE_EOF && done > 0) ok = TRUE;
+    return ok != FALSE;
+}
