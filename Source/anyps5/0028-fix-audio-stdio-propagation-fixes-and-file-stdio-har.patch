index 0000000000..2ce712cb6e
--- /dev/null
+++ b/core/libs/tests/GuestStdioFaultRead.cpp
@@ -0,0 +1,165 @@
+#include "prx/libkernel/include/Api.hpp"
+#include "prx/libc/include/Api.hpp"
+#include "prx/libc/include/general/VabiMacros.hpp"
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+namespace {
+
+constexpr std::size_t FileBytes = (192u << 10u) + 37u;
+constexpr const char* FilePath = "stdio_fault_read_generated.bin";
+
+void Require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+
+std::uint8_t PatternByte(std::size_t index) {
+    return static_cast<std::uint8_t>((index * 41u) ^ (index >> 7u) ^ (index >> 13u));
+}
+
+void VerifyPattern(const std::uint8_t* data, std::size_t startOffset, std::size_t count) {
+    for (std::size_t i = 0; i < count; ++i) {
+        if (data[i] != PatternByte(startOffset + i)) {
+            throw std::runtime_error("read content mismatch at offset " + std::to_string(startOffset + i));
+        }
+    }
+}
+
+#ifdef _WIN32
+std::uintptr_t g_guardBegin = 0;
+std::size_t g_guardBytes = 0;
+std::size_t g_guardPage = 0;
+std::size_t g_faultedPages = 0;
+
+LONG CALLBACK UnprotectOnWrite(EXCEPTION_POINTERS* exception) {
+    const auto& record = *exception->ExceptionRecord;
+    if (record.ExceptionCode != EXCEPTION_ACCESS_VIOLATION || record.NumberParameters < 2 || record.ExceptionInformation[0] != 1) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    const auto address = static_cast<std::uintptr_t>(record.ExceptionInformation[1]);
+    if (address < g_guardBegin || address - g_guardBegin >= g_guardBytes) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    const auto page = address & ~(static_cast<std::uintptr_t>(g_guardPage) - 1);
+    DWORD previous = 0;
+    if (!VirtualProtect(reinterpret_cast<void*>(page), g_guardPage, PAGE_READWRITE, &previous)) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    ++g_faultedPages;
+    return EXCEPTION_CONTINUE_EXECUTION;
+}
+
+class ReadOnlyFaultBuffer {
+public:
+    explicit ReadOnlyFaultBuffer(std::size_t bytes) : bytes(bytes) {
+        SYSTEM_INFO system{};
+        GetSystemInfo(&system);
+        pageSize = system.dwPageSize;
+        buffer = static_cast<std::uint8_t*>(VirtualAlloc(nullptr, bytes, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE));
+        Require(buffer != nullptr, "cannot allocate fault test buffer");
+        handler = AddVectoredExceptionHandler(1, UnprotectOnWrite);
+        if (handler == nullptr) {
+            VirtualFree(buffer, 0, MEM_RELEASE);
+            throw std::runtime_error("cannot install vectored exception handler");
+        }
+        g_guardBegin = reinterpret_cast<std::uintptr_t>(buffer);
+        g_guardBytes = bytes;
+        g_guardPage = pageSize;
+        ProtectReadOnly();
+    }
+
+    ~ReadOnlyFaultBuffer() {
+        g_guardBytes = 0;
+        if (handler != nullptr) RemoveVectoredExceptionHandler(handler);
+        if (buffer != nullptr) VirtualFree(buffer, 0, MEM_RELEASE);
+    }
+
+    void ProtectReadOnly() {
+        DWORD previous = 0;
+        Require(VirtualProtect(buffer, bytes, PAGE_READWRITE, &previous) != FALSE, "cannot reset buffer writable");
+        std::memset(buffer, 0xCC, bytes);
+        g_faultedPages = 0;
+        Require(VirtualProtect(buffer, bytes, PAGE_READONLY, &previous) != FALSE, "cannot mark buffer PAGE_READONLY");
+    }
+
+    std::uint8_t* Data() const { return buffer; }
+
+private:
+    std::size_t bytes = 0;
+    std::size_t pageSize = 0;
+    std::uint8_t* buffer = nullptr;
+    void* handler = nullptr;
+};
+#endif
+
+} // namespace
