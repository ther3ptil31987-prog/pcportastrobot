+int main() {
+    try {
+        {
+            std::ofstream stream(FilePath, std::ios::binary | std::ios::trunc);
+            std::array<char, 65536> chunk{};
+            for (std::size_t offset = 0; offset < FileBytes; offset += chunk.size()) {
+                const auto count = std::min(chunk.size(), FileBytes - offset);
+                for (std::size_t i = 0; i < count; ++i) chunk[i] = static_cast<char>(PatternByte(offset + i));
+                stream.write(chunk.data(), static_cast<std::streamsize>(count));
+            }
+            stream.close();
+            Require(!stream.fail(), "cannot create test file");
+        }
+
+#ifdef _WIN32
+        ReadOnlyFaultBuffer faultBuffer(FileBytes + 4096u);
+        const int fd = open_nid_postfix(FilePath, 0, 0);
+        Require(fd >= 0, "cannot open generated file via libkernel");
+
+        // 1. Positioned read (sceKernelPread -> NativePositionedTransfer) into PAGE_READONLY pages
+        Require(lseek_nid_postfix(fd, 13, 0) == 13, "cannot seek before pread");
+        const auto preadCount = sceKernelPread(fd, faultBuffer.Data(), FileBytes - 7u, 7);
+        Require(preadCount == static_cast<std::int64_t>(FileBytes - 7u), "sceKernelPread on PAGE_READONLY failed");
+        Require(g_faultedPages >= 3, "sceKernelPread did not trigger VEH on PAGE_READONLY pages");
+        Require(lseek_nid_postfix(fd, 0, 1) == 13, "sceKernelPread modified file position");
+        VerifyPattern(faultBuffer.Data(), 7, FileBytes - 7u);
