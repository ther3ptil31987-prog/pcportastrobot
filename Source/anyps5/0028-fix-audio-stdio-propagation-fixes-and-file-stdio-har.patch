+        const auto freadCount = fread_nid_postfix(faultBuffer.Data(), 1, FileBytes, stream);
+        Require(freadCount == FileBytes, "fread_nid_postfix on PAGE_READONLY failed");
+        Require(g_faultedPages >= 3, "fread_nid_postfix did not trigger VEH on PAGE_READONLY pages");
